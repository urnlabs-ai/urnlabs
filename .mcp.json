{
	"mcpServers": {
		"github": {
			"type": "stdio",
			"command": "docker",
			"args": [
				"run",
				"-i",
				"--rm",
				"-e",
				"GITHUB_PERSONAL_ACCESS_TOKEN",
				"ghcr.io/github/github-mcp-server"
			],
			"env": {
				"GITHUB_PERSONAL_ACCESS_TOKEN": "${GITHUB_TOKEN}"
			},
			"description": "GitHub repository management and operations"
		},
		"filesystem": {
			"type": "stdio",
			"command": "npx",
			"args": [
				"-y",
				"@modelcontextprotocol/server-filesystem",
				"/Users/muhammadusmanramzan/Desktop/work/urnlabs-ai/urnlabs"
			],
			"env": {},
			"description": "File system operations for Urnlabs project directory"
		},
		"slack": {
			"type": "stdio",
			"command": "npx",
			"args": [
				"-y",
				"@modelcontextprotocol/server-slack"
			],
			"env": {
				"SLACK_BOT_TOKEN": "${SLACK_BOT_TOKEN}",
				"SLACK_TEAM_ID": "${SLACK_TEAM_ID}"
			},
			"description": "Slack API operations and team messaging"
		},
		"sequential-thinking": {
			"type": "stdio",
			"command": "npx",
			"args": [
				"-y",
				"@modelcontextprotocol/server-sequential-thinking"
			],
			"description": "Breaks down complex problems into manageable steps for structured problem-solving"
		},
		"puppeteer": {
			"type": "stdio",
			"command": "npx",
			"args": [
				"-y",
				"@hisma/server-puppeteer"
			],
			"description": "Navigate websites, take screenshots, interact with web pages using Puppeteer"
		},
		"memory-bank": {
			"type": "stdio",
			"command": "npx",
			"args": [
				"-y",
				"@modelcontextprotocol/server-memory"
			],
			"description": "Organizes project knowledge hierarchically with persistent memory across sessions"
		},
		"superdesign": {
			"type": "stdio",
			"command": "node",
			"args": [
				"/Users/muhammadusmanramzan/Desktop/work/urnlabs-ai/superdesign-mcp-claude-code/dist/index.js"
			],
			"env": {
				"DESIGN_SYSTEM_PATH": "/Users/muhammadusmanramzan/Desktop/work/urnlabs-ai/urnlabs/.superdesign",
				"COMPONENT_LIBRARY": "shadcn-ui"
			},
			"description": "AI design system and component generation tools"
		},
		"shadcn": {
			"type": "stdio",
			"command": "npx",
			"args": [
				"shadcn@latest",
				"mcp"
			],
			"description": "shadcn/ui component library integration and management"
		},
		"task-master-ai": {
			"type": "stdio",
			"command": "npx",
			"args": [
				"-y",
				"--package=task-master-ai",
				"task-master-ai"
			],
			"env": {
				"ANTHROPIC_API_KEY": "YOUR_ANTHROPIC_API_KEY_HERE",
				"PERPLEXITY_API_KEY": "YOUR_PERPLEXITY_API_KEY_HERE",
				"OPENAI_API_KEY": "YOUR_OPENAI_KEY_HERE",
				"GOOGLE_API_KEY": "YOUR_GOOGLE_KEY_HERE",
				"XAI_API_KEY": "YOUR_XAI_KEY_HERE",
				"OPENROUTER_API_KEY": "YOUR_OPENROUTER_KEY_HERE",
				"MISTRAL_API_KEY": "YOUR_MISTRAL_KEY_HERE",
				"AZURE_OPENAI_API_KEY": "YOUR_AZURE_KEY_HERE",
				"OLLAMA_API_KEY": "YOUR_OLLAMA_API_KEY_HERE"
			}
		}
	}
}
