# Vault-Enabled Environment Configuration
# =====================================
# This configuration uses HashiCorp Vault for secrets management
# Replace hardcoded secrets with Vault references

# Node Environment
NODE_ENV=development

# Vault Configuration
VAULT_ADDR=http://vault:8200
VAULT_ROLE_ID=your-vault-role-id
VAULT_SECRET_ID=your-vault-secret-id
VAULT_NAMESPACE=
VAULT_TIMEOUT=10000

# Services Configuration (non-sensitive)
HOST=0.0.0.0
GATEWAY_PORT=7000
API_PORT=7001
AGENT_SERVICE_PORT=7002
BRIDGE_PORT=7008
DASHBOARD_PORT=7004
SECURITY_PORT=7009
MONITORING_PORT=7006

# Database Configuration (will be retrieved from Vault)
# These are fallback values for local development only
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_NAME=urnlabs_dev
# DATABASE_URL, DATABASE_USER, DATABASE_PASSWORD retrieved from Vault

# Redis Configuration (will be retrieved from Vault)
REDIS_HOST=redis
REDIS_PORT=6379
# REDIS_URL retrieved from Vault

# Service Endpoints
API_ENDPOINT=http://api:7001
AGENTS_ENDPOINT=http://agents:7002
BRIDGE_ENDPOINT=http://bridge:7008
DASHBOARD_ENDPOINT=http://dashboard:7004
MAESTRO_ENDPOINT=http://urn-maestro:7005
MONITORING_ENDPOINT=http://monitoring:7006
INTEGRATIONS_ENDPOINT=http://integrations:7010
GATEWAY_URL=http://gateway:7000

# External API Keys (stored in Vault)
# These are placeholders - real values stored in Vault
CLAUDE_API_KEY=vault:secret/api-keys/claude#api_key
GITHUB_APP_ID=vault:secret/api-keys/github#app_id
GITHUB_APP_PRIVATE_KEY=vault:secret/api-keys/github#private_key
GITHUB_WEBHOOK_SECRET=vault:secret/api-keys/github#webhook_secret
GITHUB_CLIENT_ID=vault:secret/api-keys/github#client_id
GITHUB_CLIENT_SECRET=vault:secret/api-keys/github#client_secret
GITHUB_TOKEN=vault:secret/api-keys/github#token

SLACK_CLIENT_ID=vault:secret/api-keys/slack#client_id
SLACK_CLIENT_SECRET=vault:secret/api-keys/slack#client_secret
SLACK_SIGNING_SECRET=vault:secret/api-keys/slack#signing_secret
SLACK_BOT_TOKEN=vault:secret/api-keys/slack#bot_token
SLACK_APP_TOKEN=vault:secret/api-keys/slack#app_token
SLACK_TEAM_ID=vault:secret/api-keys/slack#team_id

# Monitoring & Analytics
DATADOG_API_KEY=vault:secret/api-keys/monitoring#datadog_api_key
NEW_RELIC_LICENSE_KEY=vault:secret/api-keys/monitoring#new_relic_license
SONAR_HOST_URL=vault:secret/api-keys/monitoring#sonar_host_url
SONAR_TOKEN=vault:secret/api-keys/monitoring#sonar_token
SNYK_TOKEN=vault:secret/api-keys/monitoring#snyk_token

# Atlassian Services
JIRA_API_TOKEN=vault:secret/api-keys/atlassian#jira_api_token
JIRA_PAT=vault:secret/api-keys/atlassian#jira_pat
CONFLUENCE_API_TOKEN=vault:secret/api-keys/atlassian#confluence_api_token

# Other Services
JENKINS_API_TOKEN=vault:secret/api-keys/jenkins#api_token
GITLAB_ACCESS_TOKEN=vault:secret/api-keys/gitlab#access_token

# AI Providers
GEMINI_API_KEY=vault:secret/api-keys/ai-providers#gemini_api_key
QWEN_API_KEY=vault:secret/api-keys/ai-providers#qwen_api_key

# Application Configuration
MAX_AGENTS_PER_ORG=100
DEFAULT_LOAD_BALANCING_ALGORITHM=round_robin
AUTO_SCALING_ENABLED=true
PROMETHEUS_ENABLED=true
LOG_LEVEL=info

# Frontend URLs (for CORS and client configuration)
FRONTEND_URL=http://localhost:3000
VITE_GATEWAY_URL=http://localhost:7000
VITE_API_URL=http://localhost:7000/api
VITE_AGENTS_URL=http://localhost:7000/agents
VITE_BRIDGE_URL=http://localhost:7000/bridge
VITE_MAESTRO_URL=http://localhost:7000/maestro
VITE_WS_URL=ws://localhost:7000/ws

# Security Configuration
ENCRYPTION_ALGORITHM=AES-256-GCM
JWT_ALGORITHM=HS256
JWT_EXPIRATION=1h

# Secrets Management
SECRETS_ROTATION_ENABLED=true
SECRETS_SCANNING_ENABLED=true
SECRETS_CACHE_ENABLED=true
SECRETS_CACHE_TTL=300000

# Development & Testing
DOCKER_HOST=unix:///var/run/docker.sock
WEBSOCKET_PORT=8080
MCP_SERVICE_PORT=7007
TESTING_PORT=7008

# Prometheus & Grafana
PROMETHEUS_URL=http://prometheus:9090
GRAFANA_URL=http://grafana:3001

# Notes:
# ======
# 1. Values starting with "vault:" will be resolved by the secrets manager
# 2. For local development, fallback values are used if Vault is unavailable
# 3. In production, all sensitive values should be stored in Vault
# 4. Use the secrets management API to update values in Vault
# 5. Secrets rotation is handled automatically based on configured policies