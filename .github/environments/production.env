# Production Environment Configuration
NODE_ENV=production
LOG_LEVEL=warn

# Database Configuration
DATABASE_URL=${PRODUCTION_DATABASE_URL}
REDIS_URL=${PRODUCTION_REDIS_URL}

# API Configuration
API_PORT=7001
API_HOST=0.0.0.0
JWT_SECRET=${PRODUCTION_JWT_SECRET}
JWT_EXPIRES_IN=1h

# Agent Service Configuration
AGENTS_PORT=7002
AGENTS_HOST=0.0.0.0
AGENT_REGISTRY_URL=https://api.urnlabs.ai

# Gateway Configuration
GATEWAY_PORT=7000
GATEWAY_HOST=0.0.0.0
UPSTREAM_API_URL=http://api:7001
UPSTREAM_AGENTS_URL=http://agents:7002

# Bridge Service Configuration
BRIDGE_PORT=7003
BRIDGE_HOST=0.0.0.0

# Dashboard Configuration
DASHBOARD_PORT=7004
DASHBOARD_HOST=0.0.0.0
DASHBOARD_API_URL=https://gateway.urnlabs.ai

# Security Configuration (Maximum Security)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX=50
RATE_LIMIT_WINDOW=900000
CORS_ENABLED=true
CORS_ORIGINS=https://urnlabs.ai,https://dashboard.urnlabs.ai
MFA_REQUIRED=true

# Monitoring Configuration
PROMETHEUS_ENABLED=true
GRAFANA_ENABLED=true
HEALTH_CHECK_INTERVAL=10000

# External Services (Production)
SLACK_WEBHOOK_URL=${PRODUCTION_SLACK_WEBHOOK}
GITHUB_TOKEN=${GITHUB_TOKEN}
SNYK_TOKEN=${SNYK_TOKEN}

# Production Features
MOCK_EXTERNAL_SERVICES=false
ENABLE_DEBUG_ENDPOINTS=false
BYPASS_AUTH_FOR_TESTING=false

# Performance Monitoring
APM_ENABLED=true
PERFORMANCE_MONITORING=true
ERROR_TRACKING=true

# SSL/TLS Configuration
HTTPS_ENABLED=true
SSL_REDIRECT=true
HSTS_ENABLED=true

# Security Headers
SECURITY_HEADERS_ENABLED=true
CSP_ENABLED=true
FRAME_OPTIONS=DENY

# Backup and Recovery
AUTOMATED_BACKUPS=true
BACKUP_RETENTION_DAYS=30
DISASTER_RECOVERY_ENABLED=true

# Auto-scaling Configuration
AUTO_SCALING_ENABLED=true
MIN_INSTANCES=2
MAX_INSTANCES=10
CPU_THRESHOLD=70
MEMORY_THRESHOLD=80