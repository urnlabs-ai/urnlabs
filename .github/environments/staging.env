# Staging Environment Configuration
NODE_ENV=staging
LOG_LEVEL=info

# Database Configuration
DATABASE_URL=${STAGING_DATABASE_URL}
REDIS_URL=${STAGING_REDIS_URL}

# API Configuration
API_PORT=7001
API_HOST=0.0.0.0
JWT_SECRET=${STAGING_JWT_SECRET}
JWT_EXPIRES_IN=24h

# Agent Service Configuration
AGENTS_PORT=7002
AGENTS_HOST=0.0.0.0
AGENT_REGISTRY_URL=https://staging-api.urnlabs.ai

# Gateway Configuration
GATEWAY_PORT=7000
GATEWAY_HOST=0.0.0.0
UPSTREAM_API_URL=http://staging-api:7001
UPSTREAM_AGENTS_URL=http://staging-agents:7002

# Bridge Service Configuration
BRIDGE_PORT=7003
BRIDGE_HOST=0.0.0.0

# Dashboard Configuration
DASHBOARD_PORT=7004
DASHBOARD_HOST=0.0.0.0
DASHBOARD_API_URL=https://staging-gateway.urnlabs.ai

# Security Configuration (Production-like)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=900000
CORS_ENABLED=true
CORS_ORIGINS=https://staging.urnlabs.ai,https://staging-dashboard.urnlabs.ai
MFA_REQUIRED=true

# Monitoring Configuration
PROMETHEUS_ENABLED=true
GRAFANA_ENABLED=true
HEALTH_CHECK_INTERVAL=15000

# External Services (Staging)
SLACK_WEBHOOK_URL=${STAGING_SLACK_WEBHOOK}
GITHUB_TOKEN=${GITHUB_TOKEN}
SNYK_TOKEN=${SNYK_TOKEN}

# Staging Features
MOCK_EXTERNAL_SERVICES=false
ENABLE_DEBUG_ENDPOINTS=true
BYPASS_AUTH_FOR_TESTING=false

# Performance Monitoring
APM_ENABLED=true
PERFORMANCE_MONITORING=true
ERROR_TRACKING=true

# SSL/TLS Configuration
HTTPS_ENABLED=true
SSL_REDIRECT=true