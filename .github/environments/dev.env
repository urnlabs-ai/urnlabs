# Development Environment Configuration
NODE_ENV=development
LOG_LEVEL=debug

# Database Configuration
DATABASE_URL=postgresql://dev_user:dev_password@dev-postgres:5432/urnlabs_dev
REDIS_URL=redis://dev-redis:6379

# API Configuration
API_PORT=7001
API_HOST=0.0.0.0
JWT_SECRET=dev_jwt_secret_key_not_for_production
JWT_EXPIRES_IN=7d

# Agent Service Configuration
AGENTS_PORT=7002
AGENTS_HOST=0.0.0.0
AGENT_REGISTRY_URL=http://dev-api:7001

# Gateway Configuration
GATEWAY_PORT=7000
GATEWAY_HOST=0.0.0.0
UPSTREAM_API_URL=http://dev-api:7001
UPSTREAM_AGENTS_URL=http://dev-agents:7002

# Bridge Service Configuration
BRIDGE_PORT=7003
BRIDGE_HOST=0.0.0.0

# Dashboard Configuration
DASHBOARD_PORT=7004
DASHBOARD_HOST=0.0.0.0
DASHBOARD_API_URL=http://dev-gateway:7000

# Security Configuration (Relaxed for Development)
RATE_LIMIT_ENABLED=false
CORS_ENABLED=true
CORS_ORIGINS=http://localhost:3000,http://localhost:7004
MFA_REQUIRED=false

# Monitoring Configuration
PROMETHEUS_ENABLED=true
GRAFANA_ENABLED=true
HEALTH_CHECK_INTERVAL=30000

# External Services (Development/Mock)
SLACK_WEBHOOK_URL=
GITHUB_TOKEN=
SNYK_TOKEN=

# Development Features
MOCK_EXTERNAL_SERVICES=true
ENABLE_DEBUG_ENDPOINTS=true
BYPASS_AUTH_FOR_TESTING=false