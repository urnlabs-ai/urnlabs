# API Keys
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
GOOGLE_API_KEY=your_google_api_key_here
COHERE_API_KEY=your_cohere_api_key_here
HUGGING_FACE_API_KEY=your_hugging_face_api_key_here

# Vector Database Configuration
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_ENVIRONMENT=your_pinecone_environment
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=your_qdrant_api_key_here

# Local Model Configuration
OLLAMA_HOST=http://localhost:11434

# Database
DATABASE_URL=postgresql://username:password@localhost:5432/urnlabs_dev

# Redis
REDIS_URL=redis://localhost:6379

# Service Configuration
PORT=7006
NODE_ENV=development
ML_PLATFORM_API_KEY=your_ml_platform_api_key_here

# Model Storage
MODEL_STORAGE_PATH=./models
DATASET_STORAGE_PATH=./datasets

# AutoML Configuration
AUTOML_MAX_TRIALS=100
AUTOML_TIMEOUT_MINUTES=120

# Monitoring
PROMETHEUS_PORT=9096
METRICS_ENABLED=true