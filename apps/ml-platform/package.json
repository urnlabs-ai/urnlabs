{
  "name": "@urnlabs/ml-platform",
  "version": "1.0.0",
  "description": "Urnlabs Advanced AI/ML Platform - Multi-model support, fine-tuning, vector databases, and AutoML",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc && tsc-alias",
    "start": "node dist/server.js",
    "test": "vitest",
    "test:coverage": "vitest --coverage",
    "lint": "eslint src --ext .ts,.js",
    "lint:fix": "eslint src --ext .ts,.js --fix",
    "typecheck": "tsc --noEmit",
    "train": "tsx src/pipeline/training-worker.ts",
    "fine-tune": "tsx src/pipeline/fine-tuning-worker.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.20.8",
    "@fastify/websocket": "^10.0.1",
    "@google/generative-ai": "^0.2.1",
    "@pinecone-database/pinecone": "^1.1.2",
    "@prisma/client": "^5.7.1",
    "@qdrant/js-client-rest": "^1.7.0",
    "bullmq": "^5.1.9",
    "cohere-ai": "^7.6.2",
    "fastify": "^4.24.3",
    "huggingface": "^2.0.0",
    "ioredis": "^5.3.2",
    "lodash": "^4.17.21",
    "ml-matrix": "^6.10.6",
    "ollama": "^0.5.0",
    "openai": "^4.24.1",
    "p-queue": "^8.0.1",
    "pino": "^8.17.2",
    "sklearn": "^1.1.0",
    "tensorflowjs": "^4.15.0",
    "uuid": "^9.0.1",
    "ws": "^8.16.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/lodash": "^4.14.202",
    "@types/node": "^20.10.5",
    "@types/uuid": "^9.0.7",
    "@types/ws": "^8.5.10",
    "@typescript-eslint/eslint-plugin": "^6.15.0",
    "@typescript-eslint/parser": "^6.15.0",
    "@urnlabs/config": "workspace:*",
    "eslint": "^8.56.0",
    "tsc-alias": "^1.8.8",
    "tsx": "^4.6.2",
    "typescript": "^5.3.3",
    "vite": "^5.0.10",
    "vitest": "^1.1.0"
  }
}