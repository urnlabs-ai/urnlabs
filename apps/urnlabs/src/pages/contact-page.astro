---
import BaseLayout from '~/layouts/BaseLayout.astro';
---

<BaseLayout
  title="Contact Us - Book Your Discovery Sprint | Urnlabs"
  description="Ready to automate your workflows? Book a discovery sprint with our team. Get personalized recommendations and see how Urnlabs can transform your operations."
>
  <main>
    <!-- Contact Hero -->
    <section class="relative overflow-hidden bg-slate-900 py-24 sm:py-32">
      <div class="absolute inset-0 bg-[linear-gradient(to_right,#80808012_1px,transparent_1px),linear-gradient(to_bottom,#80808012_1px,transparent_1px)] bg-[size:24px_24px]"></div>

      <div class="relative mx-auto max-w-7xl px-6 lg:px-8">
        <div class="mx-auto max-w-2xl text-center">
          <div class="inline-flex items-center rounded-full px-3 py-1 text-sm font-medium bg-blue-500/10 text-blue-400 ring-1 ring-inset ring-blue-500/20 mb-8">
            <svg class="w-4 h-4 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" />
            </svg>
            Let's Talk
          </div>

          <h1 class="text-4xl font-bold tracking-tight text-white sm:text-6xl">
            Ready to
            <span class="bg-gradient-to-r from-blue-400 to-green-400 bg-clip-text text-transparent block mt-2">
              ship work?
            </span>
          </h1>

          <p class="mt-6 text-lg leading-8 text-slate-300 max-w-3xl mx-auto">
            Book a discovery sprint with our team. We'll analyze your workflows, identify automation opportunities,
            and show you exactly how Urnlabs can transform your operations.
          </p>
        </div>
      </div>
    </section>

    <!-- Contact Options -->
    <section class="py-24 bg-slate-950">
      <div class="container mx-auto px-6 lg:px-8">
        <div class="grid gap-8 lg:grid-cols-3">
          <!-- Discovery Sprint -->
          <div class="bg-slate-800/50 border border-slate-700/50 rounded-2xl p-8 hover:bg-slate-800/70 transition-colors lg:col-span-2">
            <div class="flex items-center mb-6">
              <div class="w-12 h-12 bg-blue-500/20 rounded-lg flex items-center justify-center mr-4">
                <svg class="w-6 h-6 text-blue-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
                </svg>
              </div>
              <div>
                <h2 class="text-2xl font-bold text-white">Discovery Sprint</h2>
                <p class="text-slate-400">Free 45-minute consultation</p>
              </div>
            </div>

            <div class="grid gap-6 md:grid-cols-2">
              <div>
                <h3 class="text-white font-semibold mb-3">What we'll cover:</h3>
                <ul class="space-y-2 text-slate-300">
                  <li class="flex items-center">
                    <svg class="w-4 h-4 text-green-400 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                    </svg>
                    Current workflow analysis
                  </li>
                  <li class="flex items-center">
                    <svg class="w-4 h-4 text-green-400 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                    </svg>
                    Automation opportunity assessment
                  </li>
                  <li class="flex items-center">
                    <svg class="w-4 h-4 text-green-400 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                    </svg>
                    ROI projections and timeline
                  </li>
                  <li class="flex items-center">
                    <svg class="w-4 h-4 text-green-400 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                    </svg>
                    Implementation roadmap
                  </li>
                  <li class="flex items-center">
                    <svg class="w-4 h-4 text-green-400 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                    </svg>
                    Live platform demonstration
                  </li>
                </ul>
              </div>

              <div>
                <h3 class="text-white font-semibold mb-3">Perfect for:</h3>
                <ul class="space-y-2 text-slate-300">
                  <li>• CTOs and technical leaders</li>
                  <li>• Operations managers</li>
                  <li>• Process automation teams</li>
                  <li>• Anyone with repetitive workflows</li>
                </ul>

                <div class="mt-6">
                  <a
                    href="#contact-form"
                    class="inline-flex items-center justify-center rounded-md bg-blue-500 px-6 py-3 text-sm font-medium text-white hover:bg-blue-600 transition-colors w-full"
                  >
                    Book Discovery Sprint
                  </a>
                </div>
              </div>
            </div>
          </div>

          <!-- Quick Contact -->
          <div class="space-y-6">
            <!-- Email -->
            <div class="bg-slate-800/50 border border-slate-700/50 rounded-lg p-6">
              <div class="flex items-center mb-4">
                <div class="w-10 h-10 bg-green-500/20 rounded-lg flex items-center justify-center mr-3">
                  <svg class="w-5 h-5 text-green-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 4.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                  </svg>
                </div>
                <div>
                  <h3 class="text-white font-semibold">Email</h3>
                  <p class="text-slate-400 text-sm">Get in touch directly</p>
                </div>
              </div>
              <a href="mailto:hello@urnlabs.ai" class="text-blue-400 hover:text-blue-300 transition-colors">
                hello@urnlabs.ai
              </a>
            </div>

            <!-- Enterprise Sales -->
            <div class="bg-slate-800/50 border border-slate-700/50 rounded-lg p-6">
              <div class="flex items-center mb-4">
                <div class="w-10 h-10 bg-yellow-500/20 rounded-lg flex items-center justify-center mr-3">
                  <svg class="w-5 h-5 text-yellow-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-4m-5 0H9m11 0a2 2 0 01-2 2H5a2 2 0 01-2-2m0 0V9a2 2 0 012-2h2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10M7 10h10M7 13h10" />
                  </svg>
                </div>
                <div>
                  <h3 class="text-white font-semibold">Enterprise Sales</h3>
                  <p class="text-slate-400 text-sm">Custom solutions</p>
                </div>
              </div>
              <a href="mailto:enterprise@urnlabs.ai" class="text-blue-400 hover:text-blue-300 transition-colors">
                enterprise@urnlabs.ai
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Contact Form -->
    <section id="contact-form" class="py-24 bg-slate-900">
      <div class="container mx-auto px-6 lg:px-8">
        <div class="max-w-2xl mx-auto">
          <div class="text-center mb-12">
            <h2 class="text-3xl font-bold text-white mb-4">
              Send us a message
            </h2>
            <p class="text-slate-300">
              Fill out the form below and we'll get back to you within 24 hours.
            </p>
          </div>

          <form class="bg-slate-800/50 border border-slate-700/50 rounded-2xl p-8">
            <div class="grid gap-6 md:grid-cols-2">
              <div>
                <label for="firstName" class="block text-sm font-medium text-slate-300 mb-2">
                  First Name *
                </label>
                <input
                  type="text"
                  id="firstName"
                  name="firstName"
                  required
                  class="w-full px-4 py-3 bg-slate-700 border border-slate-600 rounded-lg text-white placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent"
                  placeholder="John"
                />
              </div>

              <div>
                <label for="lastName" class="block text-sm font-medium text-slate-300 mb-2">
                  Last Name *
                </label>
                <input
                  type="text"
                  id="lastName"
                  name="lastName"
                  required
                  class="w-full px-4 py-3 bg-slate-700 border border-slate-600 rounded-lg text-white placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent"
                  placeholder="Doe"
                />
              </div>
            </div>

            <div class="mt-6">
              <label for="email" class="block text-sm font-medium text-slate-300 mb-2">
                Work Email *
              </label>
              <input
                type="email"
                id="email"
                name="email"
                required
                class="w-full px-4 py-3 bg-slate-700 border border-slate-600 rounded-lg text-white placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent"
                placeholder="john@company.com"
              />
            </div>

            <div class="mt-6">
              <label for="company" class="block text-sm font-medium text-slate-300 mb-2">
                Company *
              </label>
              <input
                type="text"
                id="company"
                name="company"
                required
                class="w-full px-4 py-3 bg-slate-700 border border-slate-600 rounded-lg text-white placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent"
                placeholder="Acme Inc"
              />
            </div>

            <div class="mt-6">
              <label for="message" class="block text-sm font-medium text-slate-300 mb-2">
                Tell us about your automation needs
              </label>
              <textarea
                id="message"
                name="message"
                rows="4"
                class="w-full px-4 py-3 bg-slate-700 border border-slate-600 rounded-lg text-white placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent resize-none"
                placeholder="Describe your current workflows and what you'd like to automate..."
              ></textarea>
            </div>

            <div class="mt-8">
              <button
                type="submit"
                class="w-full bg-blue-500 hover:bg-blue-600 text-white font-medium py-3 px-6 rounded-lg transition-colors focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 focus:ring-offset-slate-800"
              >
                Send Message
              </button>
            </div>

            <p class="mt-4 text-xs text-slate-400 text-center">
              By submitting this form, you agree to our privacy policy. We'll never share your information.
            </p>
          </form>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>