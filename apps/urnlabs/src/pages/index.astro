---
import BaseLayout from '~/layouts/BaseLayout.astro';
import CompanyHero from '~/components/CompanyHero';
import Features from '~/components/Features';
import Testimonials from '~/components/Testimonials';
import Pricing from '~/components/Pricing';
import Faq from '~/components/Faq';
---

<BaseLayout
  title="Urnlabs - AI Agent Platform | Deterministic Workflows & Governance"
  description="Transform your operations with deterministic AI agent workflows. Governance-first approach with measurable ROI, enterprise-grade security, and 99.9% uptime."
>
  <main>
    <!-- Hero Section -->
    <CompanyHero client:load />

    <!-- Features Section -->
    <Features client:load />

    <!-- Testimonials Section -->
    <Testimonials client:load />

    <!-- Pricing Section -->
    <Pricing client:load />

    <!-- FAQ Section -->
    <section class="bg-slate-950 py-24">
      <div class="container mx-auto px-6 lg:px-8">
        <Faq client:load />
      </div>
    </section>
  </main>
</BaseLayout>