# Server Configuration
PORT=7003
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info
API_HOST=localhost:7003
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:7000

# Database Configuration
DATABASE_URL="postgresql://username:password@localhost:5432/urnlabs_analytics?schema=public"

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Email Configuration (for reports)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
ANALYTICS_EMAIL_FROM=analytics@urnlabs.ai

# Slack Configuration (for notifications)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/SLACK/WEBHOOK

# Webhook Configuration
ANALYTICS_WEBHOOK_URL=https://your-domain.com/webhooks/analytics

# ROI Calculation Configuration
AVERAGE_HOURLY_RATE_CENTS=5000    # $50/hour
SENIOR_HOURLY_RATE_CENTS=8000     # $80/hour
JUNIOR_HOURLY_RATE_CENTS=3000     # $30/hour
SERVER_COST_PER_HOUR_CENTS=10     # $0.10/hour
AI_API_COST_MULTIPLIER=1.2        # 20% markup on AI API costs
DISCOUNT_RATE=0.1                 # 10% discount rate for NPV
TAX_RATE=0.25                     # 25% tax rate

# API Keys (for AI cost tracking)
OPENAI_API_KEY=your-openai-key
ANTHROPIC_API_KEY=your-anthropic-key
AZURE_OPENAI_API_KEY=your-azure-key

# Monitoring Configuration
ENABLE_PROMETHEUS=true
METRICS_RETENTION_DAYS=30
CLEANUP_INTERVAL_HOURS=24