# Security Service Environment Variables

# Server Configuration
NODE_ENV=development
SECURITY_PORT=7009
HOST=0.0.0.0
LOG_LEVEL=info

# JWT Configuration
JWT_ACCESS_SECRET=your-super-secret-access-key-change-this-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-this-in-production
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
JWT_ISSUER=urnlabs-security
JWT_AUDIENCE=urnlabs-platform

# Encryption Configuration
ENCRYPTION_MASTER_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
HMAC_SECRET=your-hmac-secret-for-data-integrity

# Database Configuration
DATABASE_URL=postgresql://username:password@localhost:5432/urnlabs_security
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=urnlabs_security
DATABASE_USER=username
DATABASE_PASSWORD=password
DATABASE_SSL=false

# Redis Configuration (for session storage and rate limiting)
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# CORS Configuration
CORS_ORIGIN=http://localhost:3000,http://localhost:7000,http://localhost:7001

# Cookie Configuration
COOKIE_SECRET=your-cookie-secret-change-this-in-production

# Rate Limiting Configuration
RATE_LIMIT_AUTH_WINDOW_MS=900000
RATE_LIMIT_AUTH_MAX_REQUESTS=5
RATE_LIMIT_API_WINDOW_MS=900000
RATE_LIMIT_API_MAX_REQUESTS=100

# Session Configuration
MAX_ACTIVE_SESSIONS=5
SESSION_INACTIVITY_TIMEOUT=1800000

# Security Configuration
PASSWORD_MIN_LENGTH=8
PASSWORD_REQUIRE_UPPERCASE=true
PASSWORD_REQUIRE_LOWERCASE=true
PASSWORD_REQUIRE_NUMBERS=true
PASSWORD_REQUIRE_SPECIAL_CHARS=true
PASSWORD_MAX_AGE_DAYS=90

# MFA Configuration
MFA_ISSUER=Urnlabs
MFA_WINDOW=2

# Audit Configuration
AUDIT_LOG_RETENTION_DAYS=365
AUDIT_LOG_ENCRYPTION=true

# Compliance Configuration
COMPLIANCE_SOC2_ENABLED=true
COMPLIANCE_GDPR_ENABLED=true
COMPLIANCE_ISO27001_ENABLED=true

# Monitoring and Alerting
ALERT_WEBHOOK_URL=
SLACK_WEBHOOK_URL=
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=
EMAIL_SMTP_PASS=
EMAIL_FROM_ADDRESS=security@urnlabs.ai

# External Services
VAULT_URL=http://localhost:8200
VAULT_TOKEN=
VAULT_NAMESPACE=

# Development/Testing
SWAGGER_HOST=localhost:7009
ENABLE_SWAGGER=true
ENABLE_DEBUG_LOGS=false

# Performance Configuration
MAX_REQUEST_SIZE=10485760
REQUEST_TIMEOUT=30000

# File Upload Configuration
UPLOAD_MAX_FILE_SIZE=104857600
UPLOAD_ALLOWED_TYPES=image/jpeg,image/png,application/pdf

# Backup Configuration
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=30
BACKUP_ENCRYPTION=true

# Disaster Recovery
DR_ENABLED=false
DR_REGION=us-west-2
DR_BACKUP_FREQUENCY=daily