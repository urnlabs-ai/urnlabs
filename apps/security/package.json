{
  "name": "@urnlabs/security",
  "version": "1.0.0",
  "description": "Urnlabs Enterprise Security Framework - JWT Auth, RBAC, Audit Logging, and Security Middleware",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc && tsc-alias",
    "start": "node dist/server.js",
    "test": "vitest",
    "test:coverage": "vitest --coverage",
    "test:security": "vitest run --reporter=verbose src/__tests__/security-*.test.ts",
    "test:security:coverage": "vitest run --coverage src/__tests__/security-*.test.ts",
    "test:auth": "vitest run src/__tests__/auth-*.test.ts",
    "test:rbac": "vitest run src/__tests__/rbac-*.test.ts",
    "test:audit": "vitest run src/__tests__/audit-*.test.ts",
    "lint": "eslint src --ext .ts,.js",
    "lint:fix": "eslint src --ext .ts,.js --fix",
    "typecheck": "tsc --noEmit",
    "security:scan": "npm audit && npm run test:security",
    "security:report": "npm run test:security:coverage",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:seed": "tsx src/scripts/seed.ts"
  },
  "dependencies": {
    "@fastify/cors": "^9.0.1",
    "@fastify/csrf-protection": "^7.1.0",
    "@fastify/helmet": "^11.1.1",
    "@fastify/jwt": "^8.0.1",
    "@fastify/rate-limit": "^9.1.0",
    "@fastify/swagger": "^8.14.0",
    "@fastify/swagger-ui": "^4.0.0",
    "@prisma/client": "^5.15.0",
    "@types/bcrypt": "^5.0.2",
    "argon2": "^0.40.3",
    "axios": "^1.11.0",
    "bcrypt": "^6.0.0",
    "crypto": "^1.0.1",
    "fastify": "^4.28.1",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.2",
    "pino": "^8.17.2",
    "pino-pretty": "^10.3.1",
    "prom-client": "^15.1.3",
    "speakeasy": "^2.0.0",
    "uuid": "^9.0.1",
    "winston": "^3.13.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.10.5",
    "@types/speakeasy": "^2.0.10",
    "@types/supertest": "^6.0.2",
    "@types/uuid": "^9.0.8",
    "@typescript-eslint/eslint-plugin": "^6.15.0",
    "@typescript-eslint/parser": "^6.15.0",
    "@urnlabs/config": "workspace:*",
    "eslint": "^8.56.0",
    "prisma": "^5.7.1",
    "supertest": "^6.3.4",
    "tsc-alias": "^1.8.8",
    "tsx": "^4.6.2",
    "typescript": "^5.3.3",
    "vite": "^5.0.10",
    "vitest": "^1.1.0"
  }
}