{
  "name": "@urnlabs/api",
  "version": "1.0.0",
  "description": "Urnlabs AI Agent Platform API",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc && tsc-alias",
    "start": "node dist/server.js",
    "test": "vitest",
    "test:coverage": "vitest --coverage",
    "test:jest": "jest",
    "test:jest:watch": "jest --watch",
    "test:jest:coverage": "jest --coverage",
    "test:security": "vitest run --reporter=verbose src/__tests__/security-*.test.ts",
    "test:security:coverage": "vitest run --coverage src/__tests__/security-*.test.ts",
    "test:security:ci": "vitest run --reporter=junit --outputFile=security-test-results.xml src/__tests__/security-*.test.ts",
    "lint": "eslint src --ext .ts,.js",
    "lint:fix": "eslint src --ext .ts,.js --fix",
    "typecheck": "tsc --noEmit",
    "security:scan": "npm audit && npm run test:security",
    "security:report": "npm run test:security:coverage",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "db:seed": "tsx src/scripts/seed.ts",
    "simple-server": "tsx src/simple-server.ts",
    "demo": "tsx src/demo-server.ts"
  },
  "dependencies": {
    "@fastify/cors": "^9.0.1",
    "@fastify/csrf-protection": "^7.1.0",
    "@fastify/helmet": "^11.1.1",
    "@fastify/jwt": "^8.0.1",
    "@fastify/rate-limit": "^9.1.0",
    "@fastify/swagger": "^8.14.0",
    "@fastify/swagger-ui": "^4.0.0",
    "@prisma/client": "^5.15.0",
    "@types/bcrypt": "^5.0.2",
    "@types/xml2js": "^0.4.14",
    "@urnlabs/ai-agents": "workspace:*",
    "axios": "^1.11.0",
    "bcrypt": "^6.0.0",
    "fastify": "^4.28.1",
    "ioredis": "^5.4.1",
    "openid-client": "^6.8.0",
    "passport-saml": "^3.2.4",
    "pino": "^8.17.2",
    "pino-pretty": "^10.3.1",
    "prom-client": "^15.1.3",
    "@fastify/websocket": "^10.0.1",
    "qrcode": "^1.5.4",
    "speakeasy": "^2.0.0",
    "twilio": "^5.10.0",
    "winston": "^3.13.0",
    "ws": "^8.18.0",
    "xml2js": "^0.6.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.10.5",
    "@types/qrcode": "^1.5.5",
    "@types/speakeasy": "^2.0.10",
    "@types/supertest": "^6.0.2",
    "@types/ws": "^8.5.12",
    "@typescript-eslint/eslint-plugin": "^6.15.0",
    "@typescript-eslint/parser": "^6.15.0",
    "@urnlabs/config": "workspace:*",
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "prisma": "^5.7.1",
    "supertest": "^6.3.4",
    "ts-jest": "^29.1.2",
    "tsc-alias": "^1.8.8",
    "tsx": "^4.6.2",
    "typescript": "^5.3.3",
    "vite": "^5.0.10",
    "vitest": "^1.1.0"
  }
}
