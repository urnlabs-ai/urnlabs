# Test Environment Configuration
NODE_ENV=test
PORT=3001
HOST=localhost

# Test Database Configuration
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/urnlabs_test
DATABASE_POOL_SIZE=5

# Authentication
JWT_SECRET=test-super-secret-jwt-key-minimum-32-characters-long-for-testing
JWT_EXPIRES_IN=1h
BCRYPT_SALT_ROUNDS=4

# CORS Configuration (comma-separated URLs)
CORS_ORIGINS=http://localhost:3001

# Rate Limiting
RATE_LIMIT_MAX=1000
RATE_LIMIT_WINDOW=15 minutes

# Redis (for testing)
REDIS_URL=redis://localhost:6380

# Monitoring
LOG_LEVEL=warn