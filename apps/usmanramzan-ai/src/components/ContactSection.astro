---
import { ContactForm } from './ContactForm';
---

<section id="contact" class="py-20 lg:py-32 bg-gray-50 dark:bg-slate-800/50 scroll-mt-20">
  <div class="container mx-auto px-4 sm:px-6 lg:px-8">
    <div class="max-w-4xl mx-auto">
      <!-- Section Header -->
      <div class="text-center mb-16">
        <h2 class="text-4xl lg:text-5xl font-display font-bold text-slate-900 dark:text-white mb-6">
          Get in <span class="text-brand-600 dark:text-brand-400">Touch</span>
        </h2>
        <div class="w-24 h-1 bg-gradient-to-r from-brand-500 to-indigo-500 mx-auto rounded-full"></div>
      </div>

      <ContactForm client:load />

    </div>
  </div>
</section>