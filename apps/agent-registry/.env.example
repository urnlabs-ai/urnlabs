# Agent Registry Service Environment Variables

# Server Configuration
NODE_ENV=development
PORT=7003
HOST=0.0.0.0
LOG_LEVEL=info

# API Configuration
API_HOST=localhost:7003
FRONTEND_URL=http://localhost:3000

# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/urnlabs_ai
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Configuration
JWT_SECRET=super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=24h

# Docker Configuration
DOCKER_HOST=unix:///var/run/docker.sock
DOCKER_CERT_PATH=
DOCKER_TLS_VERIFY=
DOCKER_API_VERSION=

# Health Monitoring Configuration
HEALTH_CHECK_INTERVAL=60000
HEARTBEAT_TIMEOUT=90000
WEBSOCKET_PORT=8081

# Agent Registry Configuration
MAX_AGENTS_PER_ORG=100
DEFAULT_AGENT_TIMEOUT=30000
AGENT_REGISTRY_CACHE_TTL=300

# Marketplace Configuration
MARKETPLACE_CACHE_TTL=600
MAX_DEPLOYMENTS_PER_ORG=50
DEFAULT_DEPLOYMENT_REPLICAS=1

# Load Balancing Configuration
DEFAULT_LOAD_BALANCING_ALGORITHM=round_robin
PERFORMANCE_MONITORING_ENABLED=true

# Auto-scaling Configuration
AUTO_SCALING_ENABLED=true
MIN_REPLICAS=1
MAX_REPLICAS=10
TARGET_CPU_PERCENT=70
TARGET_MEMORY_PERCENT=80

# Resource Limits
DEFAULT_CPU_LIMIT=0.5
DEFAULT_MEMORY_LIMIT=512Mi
DEFAULT_STORAGE_LIMIT=1Gi

# Image Registry Configuration
DEFAULT_IMAGE_REGISTRY=urnlabs
AGENT_IMAGE_PREFIX=urnlabs
DEFAULT_IMAGE_TAG=latest

# Security Configuration
ENABLE_RATE_LIMITING=true
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=60000

# Monitoring and Metrics
PROMETHEUS_ENABLED=true
PROMETHEUS_PORT=9090
METRICS_COLLECTION_INTERVAL=30000

# Error Handling
ERROR_STACK_TRACE_ENABLED=true
SENTRY_DSN=
SENTRY_ENVIRONMENT=development

# Backup and Recovery
BACKUP_ENABLED=false
BACKUP_INTERVAL=86400000
BACKUP_RETENTION_DAYS=30

# External Service Integrations
GITHUB_TOKEN=
SLACK_WEBHOOK_URL=
NOTIFICATION_CHANNELS=console,slack

# Development Configuration
HOT_RELOAD_ENABLED=true
DEBUG_MODE=true
MOCK_EXTERNAL_SERVICES=false