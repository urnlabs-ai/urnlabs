{
  "name": "@urnlabs/agent-registry",
  "version": "1.0.0",
  "description": "Urnlabs AI Agent Registry and Discovery System",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc && tsc-alias",
    "start": "node dist/server.js",
    "test": "vitest",
    "test:coverage": "vitest --coverage",
    "test:watch": "vitest --watch",
    "test:unit": "vitest run src/__tests__/unit/",
    "test:integration": "vitest run src/__tests__/integration/",
    "test:e2e": "vitest run src/__tests__/e2e/",
    "lint": "eslint src --ext .ts,.js",
    "lint:fix": "eslint src --ext .ts,.js --fix",
    "typecheck": "tsc --noEmit",
    "security:scan": "npm audit && npm run test:security",
    "test:security": "vitest run --reporter=verbose src/__tests__/security/",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "docker:build": "docker build -t urnlabs/agent-registry .",
    "docker:run": "docker run -p 7003:7003 urnlabs/agent-registry",
    "health": "curl -f http://localhost:7003/health || exit 1"
  },
  "dependencies": {
    "@fastify/cors": "^9.0.1",
    "@fastify/helmet": "^11.1.1",
    "@fastify/jwt": "^8.0.1",
    "@fastify/rate-limit": "^9.1.0",
    "@fastify/swagger": "^8.14.0",
    "@fastify/swagger-ui": "^4.0.0",
    "@fastify/websocket": "^10.0.1",
    "@prisma/client": "^5.15.0",
    "@urnlabs/ai-agents": "workspace:*",
    "@urnlabs/database": "workspace:*",
    "@urnlabs/auth": "workspace:*",
    "@urnlabs/monitoring": "workspace:*",
    "axios": "^1.11.0",
    "dockerode": "^4.0.2",
    "fastify": "^4.28.1",
    "ioredis": "^5.4.1",
    "node-cron": "^3.0.3",
    "pino": "^8.17.2",
    "pino-pretty": "^10.3.1",
    "prom-client": "^15.1.3",
    "semver": "^7.6.3",
    "ws": "^8.18.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/dockerode": "^3.3.31",
    "@types/node": "^20.10.5",
    "@types/node-cron": "^3.0.11",
    "@types/semver": "^7.5.8",
    "@types/supertest": "^6.0.2",
    "@types/ws": "^8.5.12",
    "@typescript-eslint/eslint-plugin": "^6.15.0",
    "@typescript-eslint/parser": "^6.15.0",
    "@urnlabs/config": "workspace:*",
    "eslint": "^8.56.0",
    "supertest": "^6.3.4",
    "tsc-alias": "^1.8.8",
    "tsx": "^4.6.2",
    "typescript": "^5.3.3",
    "vite": "^5.0.10",
    "vitest": "^1.1.0"
  }
}