{
  "name": "@urnlabs/integrations",
  "version": "1.0.0",
  "description": "Urnlabs AI Agent Platform Integrations Service",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc && tsc-alias",
    "start": "node dist/server.js",
    "test": "vitest",
    "test:coverage": "vitest --coverage",
    "test:integration": "vitest run src/__tests__/integration-*.test.ts",
    "test:webhooks": "vitest run src/__tests__/webhook-*.test.ts",
    "test:security": "vitest run --reporter=verbose src/__tests__/security-*.test.ts",
    "test:github": "vitest run src/__tests__/github-*.test.ts",
    "test:slack": "vitest run src/__tests__/slack-*.test.ts",
    "lint": "eslint src --ext .ts,.js",
    "lint:fix": "eslint src --ext .ts,.js --fix",
    "typecheck": "tsc --noEmit",
    "security:scan": "npm audit && npm run test:security",
    "webhook:validate": "tsx src/scripts/validate-webhooks.ts",
    "github:setup": "tsx src/scripts/setup-github-app.ts",
    "slack:setup": "tsx src/scripts/setup-slack-bot.ts"
  },
  "dependencies": {
    "@fastify/cors": "^9.0.1",
    "@fastify/helmet": "^11.1.1",
    "@fastify/jwt": "^8.0.1",
    "@fastify/rate-limit": "^9.1.0",
    "@fastify/swagger": "^8.14.0",
    "@fastify/swagger-ui": "^4.0.0",
    "@fastify/websocket": "^10.0.1",
    "@octokit/app": "^14.0.2",
    "@octokit/auth-app": "^6.0.1",
    "@octokit/rest": "^20.0.2",
    "@octokit/webhooks": "^12.0.4",
    "@slack/bolt": "^3.17.1",
    "@slack/web-api": "^7.0.2",
    "@slack/oauth": "^2.6.0",
    "@urnlabs/ai-agents": "workspace:*",
    "axios": "^1.11.0",
    "crypto": "^1.0.1",
    "fastify": "^4.28.1",
    "ioredis": "^5.4.1",
    "node-cron": "^3.0.3",
    "pino": "^8.17.2",
    "pino-pretty": "^10.3.1",
    "uuid": "^9.0.1",
    "ws": "^8.18.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.10.5",
    "@types/node-cron": "^3.0.11",
    "@types/uuid": "^9.0.7",
    "@types/ws": "^8.5.12",
    "@typescript-eslint/eslint-plugin": "^6.15.0",
    "@typescript-eslint/parser": "^6.15.0",
    "@urnlabs/config": "workspace:*",
    "eslint": "^8.56.0",
    "nock": "^13.5.0",
    "supertest": "^6.3.4",
    "tsc-alias": "^1.8.8",
    "tsx": "^4.6.2",
    "typescript": "^5.3.3",
    "vite": "^5.0.10",
    "vitest": "^1.1.0"
  }
}