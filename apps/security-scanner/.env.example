# Environment Configuration for Urnlabs Security Scanner

# Server Configuration
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info

# Redis Configuration (for BullMQ job queue)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Security Tool API Keys
SNYK_API_KEY=your_snyk_api_key_here
GITHUB_TOKEN=your_github_token_here

# OWASP ZAP Configuration
ZAP_API_KEY=changeme
ZAP_HOST=localhost
ZAP_PORT=8080

# CodeQL Configuration
CODEQL_PATH=/opt/codeql/codeql

# Report Configuration
REPORTS_DIR=./reports
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:4000

# Integration Settings
SLACK_WEBHOOK_URL=
GITHUB_WEBHOOK_SECRET=

# Database Configuration (if needed for persistence)
DATABASE_URL=postgresql://user:password@localhost:5432/security_scanner

# Performance Settings
MAX_CONCURRENT_SCANS=3
SCAN_TIMEOUT=600000

# Security Settings
API_KEY_HEADER=X-API-Key
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=60000