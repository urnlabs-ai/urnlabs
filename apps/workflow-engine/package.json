{
  "name": "@urnlabs/workflow-engine",
  "version": "1.0.0",
  "description": "Urnlabs AI Workflow Engine - Production-ready workflow orchestration with deterministic execution",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc && tsc-alias",
    "start": "node dist/server.js",
    "test": "vitest",
    "test:coverage": "vitest --coverage",
    "test:integration": "vitest run src/__tests__/integration/**/*.test.ts",
    "test:unit": "vitest run src/__tests__/unit/**/*.test.ts",
    "test:performance": "vitest run src/__tests__/performance/**/*.test.ts",
    "lint": "eslint src --ext .ts,.js",
    "lint:fix": "eslint src --ext .ts,.js --fix",
    "typecheck": "tsc --noEmit",
    "worker": "tsx src/worker.ts",
    "migrate": "tsx src/scripts/migrate.ts",
    "seed": "tsx src/scripts/seed.ts"
  },
  "dependencies": {
    "@fastify/cors": "^9.0.1",
    "@fastify/helmet": "^11.1.1",
    "@fastify/swagger": "^8.14.0",
    "@fastify/swagger-ui": "^4.0.0",
    "@fastify/websocket": "^10.0.1",
    "@prisma/client": "^5.15.0",
    "bullmq": "^5.1.9",
    "fastify": "^4.28.1",
    "ioredis": "^5.4.1",
    "pino": "^8.17.2",
    "pino-pretty": "^10.3.1",
    "ws": "^8.18.0",
    "zod": "^3.23.8",
    "uuid": "^9.0.1",
    "lodash": "^4.17.21",
    "p-limit": "^5.0.0",
    "semver": "^7.5.4",
    "cron-parser": "^4.9.0",
    "ajv": "^8.12.0",
    "json-schema": "^0.4.0"
  },
  "devDependencies": {
    "@types/lodash": "^4.14.202",
    "@types/node": "^20.10.5",
    "@types/semver": "^7.5.6",
    "@types/uuid": "^9.0.7",
    "@types/ws": "^8.5.12",
    "@typescript-eslint/eslint-plugin": "^6.15.0",
    "@typescript-eslint/parser": "^6.15.0",
    "@urnlabs/config": "workspace:*",
    "eslint": "^8.56.0",
    "prisma": "^5.7.1",
    "tsc-alias": "^1.8.8",
    "tsx": "^4.6.2",
    "typescript": "^5.3.3",
    "vite": "^5.0.10",
    "vitest": "^1.1.0"
  }
}