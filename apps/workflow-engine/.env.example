# Workflow Engine Environment Configuration

# Server Configuration
PORT=7005
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info

# CORS Configuration
CORS_ORIGIN=http://localhost:3000,http://localhost:7000

# Redis Configuration (for BullMQ)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Workflow Engine Configuration
MAX_PARALLEL_STEPS=10
MAX_PARALLEL_WORKFLOWS=5
STEP_TIMEOUT=300000
ENABLE_METRICS=true
ENABLE_LOGS=true

# Agent Registry Configuration
AGENT_REGISTRY_URL=http://localhost:7003
AGENT_TIMEOUT=30000
AGENT_RETRIES=3
AGENT_REGISTRY_API_KEY=

# Authentication (if required)
JWT_SECRET=your-jwt-secret-here
JWT_EXPIRES_IN=24h

# Database Configuration (if using persistent storage)
DATABASE_URL=postgresql://user:password@localhost:5432/workflow_engine

# External Services
SLACK_WEBHOOK_URL=
GITHUB_WEBHOOK_SECRET=
PAGERDUTY_API_KEY=

# Monitoring and Observability
PROMETHEUS_ENABLED=false
PROMETHEUS_PORT=9090
JAEGER_ENDPOINT=
SENTRY_DSN=

# Security
HELMET_ENABLED=true
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=60000