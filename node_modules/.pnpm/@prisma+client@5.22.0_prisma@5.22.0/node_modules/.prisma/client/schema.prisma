// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// USER MANAGEMENT & AUTHENTICATION
// ============================================================================

model Organization {
  id          String  @id @default(cuid())
  name        String
  slug        String  @unique
  description String?
  website     String?
  logo        String?
  settings    Json?

  // Subscription info
  planType     String  @default("free") // free, pro, enterprise
  planLimits   Json?
  billingEmail String?

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  users              User[]
  roles              Role[]
  agents             Agent[]
  workflows          Workflow[]
  apiKeys            ApiKey[]
  policies           Policy[]
  complianceRules    ComplianceRule[]
  securityEvents     SecurityEvent[]
  performanceMetrics PerformanceMetric[]
  auditLogs          AuditLog[]
  auditLogArchives   AuditLogArchive[]
  retentionPolicies  AuditRetentionPolicy[]
  complianceTrails   ComplianceTrail[]
  integrityChecks    AuditLogIntegrityCheck[]
  policyTemplates    PolicyTemplate[]
  policySimulations  PolicySimulation[]
  policyDeployments  PolicyDeployment[]
  simulationDatasets SimulationDataset[]
  ssoProviders       SsoProvider[]

  @@map("organizations")
}

model User {
  id              String    @id @default(cuid())
  email           String    @unique
  passwordHash    String
  firstName       String
  lastName        String
  avatar          String?
  role            String    @default("USER") // USER, ADMIN, SUPER_ADMIN
  isActive        Boolean   @default(true)
  emailVerified   Boolean   @default(false)
  emailVerifiedAt DateTime?

  // Organization relationship
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])

  // Timestamps
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  lastLoginAt    DateTime?
  lastActivityAt DateTime?

  // Relations
  refreshTokens      RefreshToken[]
  permissions        UserPermission[]
  grantedPermissions UserPermission[] @relation("GrantedPermissions")
  roles              UserRole[]
  createdRoles       Role[]           @relation("RoleCreator")
  assignedRoles      UserRole[]       @relation("RoleAssigner")
  workflowRuns       WorkflowRun[]
  notifications      Notification[]
  securityEvents     SecurityEvent[]

  // Policy-related relations
  ownedPolicies          Policy[]           @relation("PolicyOwner")
  createdPolicies        Policy[]           @relation("PolicyCreator")
  updatedPolicies        Policy[]           @relation("PolicyUpdater")
  policyVersionsChanged  PolicyVersion[]    @relation("PolicyVersionChanger")
  policyVersionsApproved PolicyVersion[]    @relation("PolicyVersionApprover")
  policyAssignments      PolicyAssignment[]

  // Multi-Factor Authentication
  mfaEnabled       Boolean   @default(false)
  mfaSecret        String? // TOTP secret (encrypted)
  mfaBackupCodes   Json? // Array of backup codes (hashed)
  mfaRecoveryCodes Json? // Array of recovery codes (hashed)
  phoneNumber      String? // For SMS MFA
  phoneVerified    Boolean   @default(false)
  lastMfaAt        DateTime? // Last successful MFA authentication
  mfaAttempts      Int       @default(0) // Failed MFA attempts counter
  mfaLockedUntil   DateTime? // MFA lockout timestamp

  // SSO Integration
  externalId    String? // ID from external identity provider
  ssoProviderId String? // SSO provider used for this user
  ssoProvider   SsoProvider? @relation(fields: [ssoProviderId], references: [id])
  lastSsoLogin  DateTime? // Last SSO authentication
  ssoMetadata   Json? // Additional SSO-specific data

  // Account linking
  linkedAccounts LinkedAccount[]

  @@map("users")
}

model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

model UserPermission {
  id           String    @id @default(cuid())
  userId       String
  permission   String
  resourceType String?   @default("global") // global, policy, policy_template, etc.
  resourceId   String? // Specific resource ID for fine-grained permissions
  grantedBy    String? // Who granted this permission
  grantedAt    DateTime  @default(now())
  expiresAt    DateTime? // Optional permission expiration
  isActive     Boolean   @default(true)
  conditions   Json      @default("{}") // Additional permission conditions

  user    User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  granter User? @relation("GrantedPermissions", fields: [grantedBy], references: [id])

  @@unique([userId, permission, resourceType, resourceId])
  @@index([userId, resourceType, resourceId])
  @@index([resourceType, resourceId])
  @@index([isActive, userId])
  @@map("user_permissions")
}

// ============================================================================
// ENHANCED RBAC SYSTEM
// ============================================================================

model Role {
  id             String  @id @default(cuid())
  name           String // Unique role name (e.g., "policy_administrator")
  displayName    String // Human-readable name (e.g., "Policy Administrator")
  description    String?
  scope          String  @default("organization") // global, organization, resource
  organizationId String?

  // Role metadata
  isSystemRole Boolean  @default(false) // System-defined vs custom roles
  isActive     Boolean  @default(true)
  createdBy    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  organization Organization?    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  creator      User?            @relation("RoleCreator", fields: [createdBy], references: [id])
  userRoles    UserRole[]
  permissions  RolePermission[]

  @@unique([name, organizationId])
  @@index([organizationId, isActive])
  @@index([scope, isActive])
  @@index([isSystemRole, isActive])
  @@map("roles")
}

model UserRole {
  id         String    @id @default(cuid())
  userId     String
  roleId     String
  assignedBy String
  assignedAt DateTime  @default(now())
  expiresAt  DateTime?
  isActive   Boolean   @default(true)

  // Assignment context (for resource-scoped roles)
  resourceType String?
  resourceId   String?

  // Relations
  user     User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role     Role @relation(fields: [roleId], references: [id], onDelete: Cascade)
  assigner User @relation("RoleAssigner", fields: [assignedBy], references: [id])

  @@unique([userId, roleId, resourceType, resourceId])
  @@index([userId, isActive])
  @@index([roleId, isActive])
  @@index([resourceType, resourceId])
  @@map("user_roles")
}

model RolePermission {
  id           String @id @default(cuid())
  roleId       String
  permission   String
  resourceType String @default("global")
  conditions   Json   @default("{}")

  // Relations
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, permission, resourceType])
  @@index([roleId])
  @@index([resourceType])
  @@map("role_permissions")
}

model PolicyPermissionDefinition {
  id               String  @id @default(cuid())
  category         String // policy_management, compliance, audit, administration
  action           String // create, read, update, delete, approve, assign, evaluate
  resourceType     String // policy, policy_template, policy_assignment, audit_log
  description      String
  requiresApproval Boolean @default(false)
  riskLevel        String  @default("medium")

  @@unique([category, action, resourceType])
  @@index([category])
  @@index([riskLevel])
  @@index([requiresApproval])
  @@map("policy_permission_definitions")
}

model ApiKey {
  id             String    @id @default(cuid())
  name           String
  key            String    @unique
  organizationId String
  isActive       Boolean   @default(true)
  permissions    String[]  @default([])
  expiresAt      DateTime?
  lastUsedAt     DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("api_keys")
}

// ============================================================================
// AI AGENT SYSTEM
// ============================================================================

model Agent {
  id              String   @id @default(cuid())
  name            String
  type            String // code-reviewer, architecture-agent, deployment-agent, etc.
  description     String
  systemPrompt    String
  capabilities    String[]
  specializations String[]
  status          String   @default("active") // active, inactive, maintenance
  version         String   @default("1.0.0")

  // Configuration
  config         Json?
  tools          String[]
  maxConcurrency Int      @default(1)

  // Organization relationship
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  workflowSteps      WorkflowStep[]
  taskExecutions     TaskExecution[]
  performanceMetrics PerformanceMetric[]

  @@map("agents")
}

model Workflow {
  id          String @id @default(cuid())
  name        String
  description String
  type        String // feature-development, bug-fix, security-audit, etc.
  status      String @default("active") // active, inactive, draft
  version     String @default("1.0.0")

  // Configuration
  config        Json?
  triggerEvents String[]

  // Organization relationship
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  steps              WorkflowStep[]
  runs               WorkflowRun[]
  performanceMetrics PerformanceMetric[]

  @@map("workflows")
}

model WorkflowStep {
  id          String @id @default(cuid())
  workflowId  String
  agentId     String
  name        String
  description String
  order       Int

  // Configuration
  config  Json?
  inputs  Json?
  outputs Json?

  // Relations
  workflow Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  agent    Agent    @relation(fields: [agentId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([workflowId, order])
  @@map("workflow_steps")
}

model WorkflowRun {
  id         String @id @default(cuid())
  workflowId String
  userId     String
  status     String @default("pending") // pending, running, completed, failed, cancelled
  priority   String @default("normal") // low, normal, high, urgent

  // Input/Output
  input  Json?
  output Json?
  error  String?

  // Metrics
  startedAt   DateTime?
  completedAt DateTime?
  duration    Int? // in milliseconds

  // Relations
  workflow       Workflow        @relation(fields: [workflowId], references: [id])
  user           User            @relation(fields: [userId], references: [id])
  taskExecutions TaskExecution[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("workflow_runs")
}

model TaskExecution {
  id            String @id @default(cuid())
  workflowRunId String
  agentId       String
  name          String
  status        String @default("pending") // pending, running, completed, failed

  // Input/Output
  input  Json?
  output Json?
  error  String?
  logs   String?

  // Metrics
  startedAt   DateTime?
  completedAt DateTime?
  duration    Int? // in milliseconds

  // Relations
  workflowRun WorkflowRun @relation(fields: [workflowRunId], references: [id], onDelete: Cascade)
  agent       Agent       @relation(fields: [agentId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("task_executions")
}

// ============================================================================
// INTEGRATIONS & EXTERNAL SERVICES
// ============================================================================

model Integration {
  id             String @id @default(cuid())
  name           String
  type           String // github, slack, jira, etc.
  organizationId String

  // Configuration
  config      Json
  credentials Json // Encrypted
  isActive    Boolean @default(true)

  // Health status
  lastHealthCheck DateTime?
  healthStatus    String    @default("unknown") // healthy, unhealthy, unknown

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, type])
  @@map("integrations")
}

// ============================================================================
// MONITORING & ANALYTICS
// ============================================================================

model Metric {
  id    String  @id @default(cuid())
  name  String
  type  String // counter, gauge, histogram
  value Float
  unit  String?
  tags  Json?

  timestamp DateTime @default(now())

  @@index([name, timestamp])
  @@map("metrics")
}

model AuditLog {
  id           String  @id @default(cuid())
  eventId      String // Unique event identifier for correlation
  eventType    String
  resourceType String
  resourceId   String?

  // Actor Information
  actorType      String // user, system, api_key, agent, external
  actorId        String?
  organizationId String?

  // Event Details
  action   String
  outcome  String @default("success") // success, failure, pending, partial
  severity String @default("info") // info, warning, error, critical

  // Data and Context
  beforeState Json?
  afterState  Json?
  changes     Json  @default("[]")
  metadata    Json  @default("{}")

  // Request Context
  sessionId  String?
  requestId  String?
  ipAddress  String?
  userAgent  String?
  endpoint   String?
  httpMethod String?

  // Policy Context
  policyId             String?
  policyVersion        String?
  complianceFrameworks String[] @default([])

  // Immutability and Integrity
  eventHash    String // SHA-256 hash for integrity verification
  previousHash String? // Previous event hash for blockchain-like integrity

  // Timestamps (immutable)
  eventTimestamp DateTime @default(now())
  ingestedAt     DateTime @default(now())

  // Relations
  organization Organization? @relation(fields: [organizationId], references: [id])
  policy       Policy?       @relation(fields: [policyId], references: [id])

  @@index([organizationId, eventTimestamp])
  @@index([resourceType, resourceId])
  @@index([actorType, actorId])
  @@index([policyId, eventTimestamp])
  @@index([eventType, outcome])
  @@index([severity, eventTimestamp])
  @@index([sessionId])
  @@index([requestId])
  @@map("audit_logs")
}

model Alert {
  id          String @id @default(cuid())
  title       String
  description String
  severity    String // info, warning, error, critical
  type        String // system, security, performance, business
  status      String @default("active") // active, acknowledged, resolved

  // Configuration
  conditions Json
  actions    Json

  // Metrics
  triggeredAt DateTime  @default(now())
  resolvedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([severity, status])
  @@index([type, triggeredAt])
  @@map("alerts")
}

// ============================================================================
// NOTIFICATIONS & COMMUNICATION
// ============================================================================

model Notification {
  id       String @id @default(cuid())
  userId   String
  title    String
  message  String
  type     String // info, success, warning, error
  priority String @default("normal") // low, normal, high

  // Status
  isRead Boolean   @default(false)
  readAt DateTime?

  // Metadata
  metadata  Json?
  expiresAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, isRead])
  @@index([createdAt])
  @@map("notifications")
}

// ============================================================================
// FILE STORAGE & DOCUMENTS
// ============================================================================

model Document {
  id       String  @id @default(cuid())
  name     String
  type     String // specification, report, log, artifact
  mimeType String
  size     Int
  url      String?
  content  String?
  metadata Json?

  // Organization context
  organizationId String?

  // Relations
  workflowRunId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([type, organizationId])
  @@index([workflowRunId])
  @@map("documents")
}

// ============================================================================
// SSO & IDENTITY PROVIDER INTEGRATION
// ============================================================================

model SsoProvider {
  id     String  @id @default(cuid())
  name   String // Human-readable name (e.g., "Company Active Directory")
  type   String // "saml", "oauth2", "openid-connect", "ldap"
  domain String? // Email domain for auto-assignment (e.g., "company.com")

  // Provider configuration
  entityId    String? // SAML Entity ID or OAuth Client ID
  ssoUrl      String? // SAML SSO URL or OAuth Authorization URL
  sloUrl      String? // SAML SLO URL (Single Logout)
  certificate String? // SAML Certificate or OAuth/OIDC Public Key
  issuer      String? // OAuth/OIDC Issuer URL

  // OAuth/OIDC specific
  clientId     String? // OAuth2/OIDC Client ID
  clientSecret String? // OAuth2/OIDC Client Secret (encrypted)
  scopes       String[] @default(["openid", "profile", "email"]) // OAuth2/OIDC Scopes
  authorizeUrl String? // OAuth2 Authorization URL
  tokenUrl     String? // OAuth2 Token URL
  userinfoUrl  String? // OIDC UserInfo URL
  jwksUrl      String? // OIDC JWKS URL

  // SAML specific
  signRequests         Boolean @default(false) // Sign SAML requests
  wantAssertionsSigned Boolean @default(true) // Require signed assertions
  nameIdFormat         String? // SAML NameID format

  // User mapping configuration
  attributeMapping Json   @default("{}") // Map provider attributes to user fields
  roleMapping      Json   @default("{}") // Map provider groups/roles to local roles
  defaultRole      String @default("USER") // Default role for new SSO users

  // Provider status and configuration
  isActive        Boolean @default(true)
  isDefault       Boolean @default(false) // Default provider for organization
  autoCreateUsers Boolean @default(true) // Auto-create users on first SSO login
  requireMfa      Boolean @default(false) // Require MFA even with SSO

  // Organization relationship
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // Timestamps
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  lastUsedAt DateTime?

  // Relations
  users          User[]
  linkedAccounts LinkedAccount[]
  ssoSessions    SsoSession[]

  @@unique([organizationId, name])
  @@index([organizationId, isActive])
  @@index([domain])
  @@index([type])
  @@map("sso_providers")
}

model LinkedAccount {
  id         String @id @default(cuid())
  userId     String
  providerId String

  // External identity information
  externalId       String // ID from the external provider
  externalEmail    String? // Email from the external provider
  externalUsername String? // Username from the external provider

  // Account metadata
  providerType String // "saml", "oauth2", "openid-connect"
  accountData  Json? // Additional account data from provider
  lastSyncAt   DateTime?

  // Status
  isActive   Boolean @default(true)
  isVerified Boolean @default(false)

  // Relations
  user     User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider SsoProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([providerId, externalId])
  @@index([userId])
  @@index([providerId, isActive])
  @@index([externalEmail])
  @@map("linked_accounts")
}

model SsoSession {
  id         String  @id @default(cuid())
  sessionId  String  @unique // SSO session identifier
  userId     String? // Linked user (null during authentication flow)
  providerId String

  // Session data
  state         String? // OAuth state parameter
  nonce         String? // OIDC nonce
  samlRequestId String? // SAML request ID
  redirectUrl   String? // Post-authentication redirect

  // Authentication flow data
  authorizationCode String? // OAuth authorization code
  accessToken       String? // OAuth access token (encrypted)
  refreshToken      String? // OAuth refresh token (encrypted)
  idToken           String? // OIDC ID token
  samlResponse      String? // SAML response (for validation)

  // Session metadata
  userInfo         Json? // User information from provider
  providerMetadata Json? // Additional provider-specific data
  ipAddress        String?
  userAgent        String?

  // Session status
  status       String  @default("pending") // pending, authenticated, expired, failed
  errorCode    String? // Error code if authentication failed
  errorMessage String? // Human-readable error message

  // Timestamps
  createdAt       DateTime  @default(now())
  expiresAt       DateTime
  authenticatedAt DateTime?
  lastAccessedAt  DateTime?

  // Relations
  provider SsoProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@index([sessionId, status])
  @@index([userId])
  @@index([providerId, status])
  @@index([expiresAt])
  @@map("sso_sessions")
}

// ============================================================================
// GOVERNANCE & POLICY ENGINE
// ============================================================================

model Policy {
  id          String @id @default(cuid())
  name        String
  description String
  type        String // access_control, data_retention, security, compliance
  category    String // security, privacy, operational, business
  priority    String @default("medium") // low, medium, high, critical
  status      String @default("active") // draft, active, deprecated, archived

  // Policy Definition (Enhanced to match Zod schema)
  rules      Json // Policy rules in structured format matching PolicyDefinitionSchema
  conditions Json? // Conditions for policy activation
  actions    Json? // Actions to take when policy is triggered
  exceptions Json? // Policy exceptions and overrides

  // Enhanced Metadata (matching PolicyMetadataSchema)
  classification       String    @default("internal") // public, internal, confidential, restricted
  ownerId              String? // Policy owner
  effectiveDate        DateTime  @default(now())
  expirationDate       DateTime?
  complianceFrameworks String[]  @default([]) // SOC2, GDPR, CCPA, HIPAA, PCI_DSS, ISO27001
  riskLevel            String    @default("medium") // low, medium, high, critical
  createdBy            String
  updatedBy            String

  // Enforcement
  isEnforced      Boolean @default(true)
  enforcementMode String  @default("strict") // strict, warn, audit

  // Organization relationship
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // User relationships
  owner   User? @relation("PolicyOwner", fields: [ownerId], references: [id])
  creator User  @relation("PolicyCreator", fields: [createdBy], references: [id])
  updater User  @relation("PolicyUpdater", fields: [updatedBy], references: [id])

  // Versioning
  version String   @default("1.0.0")
  tags    String[] @default([])

  // Timestamps
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  activatedAt   DateTime?
  deactivatedAt DateTime?

  // Relations
  complianceRules ComplianceRule[]
  securityEvents  SecurityEvent[]
  versions        PolicyVersion[]
  assignments     PolicyAssignment[]
  auditLogs       AuditLog[]
  evaluationCache PolicyEvaluationCache[]
  deployments     PolicyDeployment[]

  @@index([organizationId, status])
  @@index([type, priority])
  @@index([category, isEnforced])
  @@index([riskLevel])
  @@index([ownerId, status])
  @@index([effectiveDate])
  @@map("policies")
}

model PolicyVersion {
  id           String    @id @default(cuid())
  policyId     String
  version      String
  changes      Json      @default("[]") // Array of change objects
  changeReason String
  changedBy    String
  changedAt    DateTime  @default(now())
  approvedBy   String?
  approvedAt   DateTime?

  // Relations
  policy   Policy @relation(fields: [policyId], references: [id], onDelete: Cascade)
  changer  User   @relation("PolicyVersionChanger", fields: [changedBy], references: [id])
  approver User?  @relation("PolicyVersionApprover", fields: [approvedBy], references: [id])

  @@unique([policyId, version])
  @@index([policyId, changedAt])
  @@index([changedBy])
  @@index([approvedBy, approvedAt])
  @@map("policy_versions")
}

model PolicyAssignment {
  id             String    @id @default(cuid())
  policyId       String
  assigneeType   String // user, role, organization, group
  assigneeId     String
  assignedBy     String
  assignedAt     DateTime  @default(now())
  effectiveDate  DateTime  @default(now())
  expirationDate DateTime?
  isActive       Boolean   @default(true)

  // Relations
  policy   Policy @relation(fields: [policyId], references: [id], onDelete: Cascade)
  assigner User   @relation(fields: [assignedBy], references: [id])

  @@unique([policyId, assigneeType, assigneeId], name: "policy_assignment_unique")
  @@index([policyId, isActive])
  @@index([assigneeType, assigneeId])
  @@index([effectiveDate])
  @@map("policy_assignments")
}

model PolicyEvaluationCache {
  id               String   @id @default(cuid())
  cacheKey         String   @unique
  policyId         String
  contextHash      String
  evaluationResult Json
  cacheHitCount    Int      @default(0)
  createdAt        DateTime @default(now())
  expiresAt        DateTime

  // Relations
  policy Policy @relation(fields: [policyId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@index([policyId])
  @@index([cacheHitCount])
  @@map("policy_evaluation_cache")
}

model ComplianceRule {
  id          String @id @default(cuid())
  name        String
  description String
  framework   String // GDPR, CCPA, SOC2, ISO27001, HIPAA, PCI-DSS
  requirement String // Specific requirement identifier
  severity    String // low, medium, high, critical
  status      String @default("active") // active, inactive, exempted

  // Rule Definition
  specification String // Detailed compliance specification
  controls      Json // Required controls and measures
  evidence      Json? // Evidence requirements for compliance
  testProcedure String? // How to test compliance

  // Organization and Policy relationship
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  policyId       String?
  policy         Policy?      @relation(fields: [policyId], references: [id])

  // Compliance Status
  lastAuditDate    DateTime?
  nextAuditDate    DateTime?
  complianceStatus String    @default("unknown") // compliant, non_compliant, partial, unknown

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId, framework])
  @@index([severity, status])
  @@index([complianceStatus, nextAuditDate])
  @@map("compliance_rules")
}

model SecurityEvent {
  id       String @id @default(cuid())
  type     String // intrusion_attempt, data_breach, policy_violation, suspicious_activity
  severity String // info, low, medium, high, critical
  status   String @default("new") // new, investigating, mitigated, resolved, false_positive

  // Event Details
  title       String
  description String
  source      String // system, user, external, automated
  category    String // authentication, authorization, data_access, network, application

  // Context
  userId         String?
  user           User?        @relation(fields: [userId], references: [id])
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  policyId       String?
  policy         Policy?      @relation(fields: [policyId], references: [id])

  // Technical Details
  sourceIp  String?
  userAgent String?
  endpoint  String?
  method    String?
  payload   Json?
  metadata  Json?

  // Risk Assessment
  riskScore  Float? // 0.0 to 10.0
  impact     String? // low, medium, high, critical
  likelihood String? // low, medium, high

  // Response
  assignedTo      String?
  responseActions Json?
  resolution      String?

  // Timestamps
  detectedAt     DateTime  @default(now())
  acknowledgedAt DateTime?
  resolvedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([organizationId, severity, status])
  @@index([type, detectedAt])
  @@index([userId, detectedAt])
  @@index([riskScore])
  @@map("security_events")
}

model PerformanceMetric {
  id       String @id @default(cuid())
  name     String
  category String // api_response, database_query, agent_execution, workflow_completion
  metric   String // response_time, throughput, error_rate, cpu_usage, memory_usage
  value    Float
  unit     String // ms, seconds, percent, bytes, requests_per_second

  // Context
  organizationId String?
  agentId        String?
  workflowId     String?
  workflowRunId  String?
  endpoint       String?

  // Dimensions
  tags        Json? // Additional dimensions for querying
  environment String  @default("production") // development, staging, production
  region      String?

  // Thresholds
  threshold  Float? // Performance threshold for alerting
  isAlert    Boolean @default(false)
  alertLevel String? // warning, critical

  // Relations
  organization Organization? @relation(fields: [organizationId], references: [id])
  agent        Agent?        @relation(fields: [agentId], references: [id])
  workflow     Workflow?     @relation(fields: [workflowId], references: [id])

  // Timestamps
  timestamp DateTime @default(now())
  createdAt DateTime @default(now())

  @@index([organizationId, category, metric, timestamp])
  @@index([agentId, metric, timestamp])
  @@index([workflowId, metric, timestamp])
  @@index([isAlert, alertLevel])
  @@index([name, timestamp])
  @@map("performance_metrics")
}

// ============================================================================
// AUDIT LOG AGGREGATION & COMPLIANCE TRAILS
// ============================================================================

model AuditLogArchive {
  id            String @id @default(cuid())
  originalLogId String // Reference to original AuditLog

  // Archive metadata
  archiveReason       String // retention_policy, compliance_requirement, manual
  archiveDate         DateTime @default(now())
  retentionUntil      DateTime // When this archive can be deleted
  complianceFramework String? // GDPR, SOX, HIPAA, etc.

  // Compressed and encrypted log data
  compressedData  Bytes // Compressed JSON of original log data
  encryptionKey   String // Key identifier for decryption
  compressionType String @default("gzip") // gzip, brotli

  // Integrity verification
  archiveHash        String // Hash of compressed data
  originalHash       String // Original event hash from AuditLog
  verificationStatus String @default("verified") // verified, tampered, corrupted

  // Relations
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])

  @@index([organizationId, archiveDate])
  @@index([retentionUntil])
  @@index([complianceFramework])
  @@index([originalLogId])
  @@map("audit_log_archives")
}

model AuditRetentionPolicy {
  id          String  @id @default(cuid())
  name        String
  description String?

  // Policy criteria
  organizationId       String?
  eventTypes           String[] // Which event types this policy applies to
  resourceTypes        String[] // Which resource types this policy applies to
  severity             String[] // Which severity levels this policy applies to
  complianceFrameworks String[] // GDPR, SOX, HIPAA, etc.

  // Retention rules
  activeRetentionDays  Int // Days to keep in active storage
  archiveRetentionDays Int // Days to keep in archive storage
  totalRetentionDays   Int // Total retention period (active + archive)

  // Archive configuration
  enableArchiving    Boolean @default(true)
  compressionEnabled Boolean @default(true)
  encryptionEnabled  Boolean @default(true)

  // Policy metadata
  isActive  Boolean @default(true)
  priority  Int     @default(100) // Higher number = higher priority
  createdBy String

  // Relations
  organization Organization? @relation(fields: [organizationId], references: [id])

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId, isActive])
  @@index([eventTypes])
  @@index([priority])
  @@map("audit_retention_policies")
}

model ComplianceTrail {
  id      String @id @default(cuid())
  trailId String @unique // Unique identifier for the compliance trail

  // Trail metadata
  name                String
  description         String?
  complianceFramework String // GDPR, SOX, HIPAA, PCI-DSS, etc.

  // Trail configuration
  organizationId String?
  startDate      DateTime
  endDate        DateTime?

  // Event filtering
  eventTypes     String[] // Types of events to include in this trail
  resourceTypes  String[] // Types of resources to track
  actorTypes     String[] // Types of actors to track
  severityLevels String[] // Severity levels to include

  // Trail integrity
  trailHash     String // Cumulative hash of all events in trail
  eventCount    Int     @default(0)
  lastEventId   String? // Last audit log event included
  lastEventHash String? // Hash of last event for chain integrity

  // Compliance verification
  verificationStatus String    @default("active") // active, verified, sealed, tampered
  verifiedAt         DateTime?
  verifiedBy         String?
  digitalSignature   String? // Digital signature for non-repudiation

  // Relations
  organization Organization?          @relation(fields: [organizationId], references: [id])
  events       ComplianceTrailEvent[]

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId, complianceFramework])
  @@index([trailId])
  @@index([verificationStatus])
  @@index([startDate, endDate])
  @@map("compliance_trails")
}

model ComplianceTrailEvent {
  id         String @id @default(cuid())
  trailId    String
  auditLogId String // Reference to AuditLog

  // Event position in trail
  sequenceNumber    Int // Order of event in the trail
  eventHash         String // Hash of the audit event
  previousEventHash String? // Previous event hash in trail

  // Compliance metadata
  complianceRelevance String // high, medium, low
  regulatoryTags      String[] // Specific regulatory requirements this event addresses

  // Relations
  trail ComplianceTrail @relation(fields: [trailId], references: [id], onDelete: Cascade)

  // Timestamps
  addedAt DateTime @default(now())

  @@unique([trailId, sequenceNumber])
  @@index([trailId, sequenceNumber])
  @@index([auditLogId])
  @@map("compliance_trail_events")
}

model AuditLogIntegrityCheck {
  id String @id @default(cuid())

  // Check metadata
  checkType      String // integrity_verification, tamper_detection, chain_validation
  organizationId String?

  // Check parameters
  startDate  DateTime
  endDate    DateTime
  eventCount Int

  // Check results
  status            String // passed, failed, warning
  integrityScore    Float // 0.0 to 1.0
  issuesFound       Int     @default(0)
  tamperingDetected Boolean @default(false)

  // Detailed results
  checkResults    Json // Detailed findings
  failedEvents    String[] // IDs of events that failed verification
  recommendations String[] // Recommended actions

  // Check execution
  executedBy    String // user_id or system
  executionTime Int // Milliseconds taken

  // Relations
  organization Organization? @relation(fields: [organizationId], references: [id])

  // Timestamps
  createdAt DateTime @default(now())

  @@index([organizationId, createdAt])
  @@index([status, tamperingDetected])
  @@index([checkType])
  @@map("audit_log_integrity_checks")
}

// ============================================================================
// POLICY TEMPLATES AND SIMULATION
// ============================================================================

model PolicyTemplate {
  id String @id @default(cuid())

  // Template metadata
  name        String
  description String
  category    String // access_control, data_protection, security, compliance, operational
  framework   String? // GDPR, SOX, HIPAA, PCI-DSS, ISO27001, CCPA, NIST, SOC2
  version     String  @default("1.0")
  isBuiltIn   Boolean @default(false) // System-provided vs custom templates
  isActive    Boolean @default(true)

  // Template definition
  policyType    String // Same as Policy.type for compatibility
  rules         Json // Template rule definitions with placeholders
  parameters    Json // Configurable parameters for the template
  defaultConfig Json // Default configuration values

  // Usage and validation
  usageCount Int      @default(0)
  tags       String[] // Searchable tags
  complexity String   @default("medium") // low, medium, high

  // Lifecycle management
  createdBy      String? // User who created the template
  organizationId String? // If null, it's a global template
  organization   Organization? @relation(fields: [organizationId], references: [id])

  // Relations
  simulations PolicySimulation[]
  deployments PolicyDeployment[]

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category, framework])
  @@index([isBuiltIn, isActive])
  @@index([organizationId])
  @@index([tags])
  @@map("policy_templates")
}

model PolicySimulation {
  id String @id @default(cuid())

  // Simulation metadata
  name        String
  description String?
  templateId  String
  template    PolicyTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  // Simulation configuration
  scenarioType    String // historical_replay, synthetic_load, edge_cases, compliance_test
  testParameters  Json // Parameters for the simulation
  simulatedPolicy Json // The policy configuration being tested

  // Test data configuration
  useHistoricalData Boolean   @default(true)
  dataStartDate     DateTime?
  dataEndDate       DateTime?
  syntheticDataSize Int? // Number of synthetic events to generate

  // Simulation results
  status   String @default("pending") // pending, running, completed, failed
  progress Float  @default(0.0) // 0.0 to 1.0
  results  Json? // Detailed simulation results
  summary  Json? // Summary statistics

  // Performance metrics
  eventsProcessed Int  @default(0)
  violationsFound Int  @default(0)
  falsePositives  Int  @default(0)
  executionTime   Int? // Milliseconds

  // Organization context
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])
  createdBy      String // User who initiated the simulation

  // Timestamps
  createdAt   DateTime  @default(now())
  startedAt   DateTime?
  completedAt DateTime?

  @@index([templateId])
  @@index([status])
  @@index([organizationId, createdBy])
  @@index([scenarioType])
  @@map("policy_simulations")
}

model PolicyDeployment {
  id String @id @default(cuid())

  // Deployment metadata
  templateId String
  template   PolicyTemplate @relation(fields: [templateId], references: [id])
  policyId   String? // Resulting policy if deployed
  policy     Policy?        @relation(fields: [policyId], references: [id])

  // Deployment configuration
  deploymentConfig Json // Final configuration used for deployment
  validatedBy      String? // User who validated the deployment
  deployedBy       String // User who executed the deployment

  // Deployment status
  status            String  @default("pending") // pending, validating, deploying, active, failed, rolled_back
  validationResults Json? // Results from pre-deployment validation
  rollbackReason    String? // Reason for rollback if applicable

  // Performance tracking
  deploymentTime Int? // Time taken to deploy (milliseconds)
  activationTime DateTime? // When the policy became active

  // Organization context
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // Timestamps
  createdAt    DateTime  @default(now())
  deployedAt   DateTime?
  rolledBackAt DateTime?

  @@index([templateId])
  @@index([policyId])
  @@index([organizationId, status])
  @@index([deployedBy])
  @@map("policy_deployments")
}

model SimulationDataset {
  id String @id @default(cuid())

  // Dataset metadata
  name        String
  description String?
  datasetType String // historical_audit_logs, synthetic_events, compliance_scenarios
  size        Int // Number of records

  // Data configuration
  dataSchema      Json // Schema definition for the dataset
  dataSource      String? // Source of the data (if historical)
  generationRules Json? // Rules for synthetic data generation

  // Quality metrics
  qualityScore  Float? // Data quality score (0.0 to 1.0)
  coverage      Json? // Coverage metrics (event types, time periods, etc.)
  lastValidated DateTime?

  // Usage tracking
  usageCount Int @default(0)

  // Organization context
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])
  createdBy      String

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([datasetType])
  @@index([organizationId])
  @@index([size])
  @@map("simulation_datasets")
}
