{
  "name": "@urnlabs/mobile-sdk-react-native",
  "version": "1.0.0",
  "description": "Urnlabs Mobile SDK for React Native",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "eslint src --ext .ts,.tsx",
    "lint:fix": "eslint src --ext .ts,.tsx --fix",
    "clean": "rimraf dist"
  },
  "keywords": [
    "urnlabs",
    "ai",
    "agent",
    "mobile",
    "sdk",
    "react-native",
    "typescript"
  ],
  "author": "Urnlabs",
  "license": "MIT",
  "peerDependencies": {
    "react": ">=16.8.0",
    "react-native": ">=0.60.0"
  },
  "dependencies": {
    "@urnlabs/mobile-sdk-core": "workspace:*",
    "@react-native-async-storage/async-storage": "^1.21.0",
    "react-native-websocket": "^1.0.2",
    "@react-native-community/netinfo": "^11.1.0",
    "react-native-fs": "^2.20.0",
    "@react-native-firebase/messaging": "^18.6.1",
    "react-native-keychain": "^8.1.2",
    "@react-native-community/push-notification-ios": "^1.11.0",
    "react-native-background-job": "^1.1.5",
    "react-native-biometrics": "^3.0.1",
    "react-native-document-picker": "^9.1.1",
    "react-native-image-picker": "^7.1.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.45",
    "@types/react-native": "^0.72.8",
    "@types/jest": "^29.5.12",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "rimraf": "^5.0.5",
    "ts-jest": "^29.1.1",
    "typescript": "^5.3.3"
  },
  "jest": {
    "preset": "react-native",
    "setupFilesAfterEnv": ["<rootDir>/src/__tests__/setup.ts"],
    "testMatch": ["**/__tests__/**/*.test.{ts,tsx}"],
    "collectCoverageFrom": [
      "src/**/*.{ts,tsx}",
      "!src/**/*.d.ts",
      "!src/**/*.test.{ts,tsx}",
      "!src/__tests__/**/*"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 85,
        "functions": 85,
        "lines": 85,
        "statements": 85
      }
    }
  }
}