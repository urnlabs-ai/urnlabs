// Notification model additions (if not already present):
model Notification {
  id                    String   @id @default(cuid())
  type                  String   // policy_violation, escalation_notification, approval_required, etc.
  title                 String
  message               String
  urgency               String   @default("medium") // low, medium, high, critical

  // Recipient
  recipientEmail        String
  recipientUserId       String?

  // Status and timing
  status                String   @default("pending") // pending, sent, delivered, read, failed
  createdAt             DateTime @default(now())
  sentAt                DateTime?
  readAt                DateTime?
  expiresAt             DateTime?

  // Context
  relatedResourceType   String?  // remediation_execution, policy_violation, etc.
  relatedResourceId     String?

  // Metadata
  metadata              Json     @default("{}")

  // Retry tracking
  attempts              Int      @default(0)
  maxAttempts           Int      @default(3)
  lastAttemptAt         DateTime?

  // Indexes
  @@index([recipientEmail, status])
  @@index([type, status, createdAt])
  @@index([urgency, status])
  @@index([relatedResourceType, relatedResourceId])
  @@map("notifications")
}

// ApprovalRequest model (if not already present):
model ApprovalRequest {
  id                    String   @id @default(cuid())

  // Request details
  taskId                String?
  violationId           String?
  requesterId           String
  reason                String

  // Approvers
  approverEmails        String[] @default([])
  requireAllApprovers   Boolean  @default(false)

  // Status and timing
  status                String   @default("pending") // pending, approved, rejected, expired
  createdAt             DateTime @default(now())
  expiresAt             DateTime

  // Resolution
  approvedBy            String?
  approvedAt            DateTime?
  rejectedBy            String?
  rejectedAt            DateTime?
  rejectionReason       String?

  // Metadata
  metadata              Json     @default("{}")

  // Indexes
  @@index([status, expiresAt])
  @@index([approverEmails])
  @@index([violationId])
  @@map("approval_requests")
}