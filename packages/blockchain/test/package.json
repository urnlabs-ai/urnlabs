{
  "name": "@urnlabs/blockchain-tests",
  "version": "1.0.0",
  "description": "Comprehensive test suite for Urnlabs blockchain components",
  "main": "index.js",
  "scripts": {
    "test": "hardhat test",
    "test:contracts": "hardhat test test/contracts/**/*.test.ts",
    "test:services": "hardhat test test/services/**/*.test.ts",
    "test:integration": "hardhat test test/integration/**/*.test.ts",
    "test:coverage": "hardhat coverage",
    "test:gas": "REPORT_GAS=true hardhat test",
    "test:watch": "hardhat test --watch",
    "test:parallel": "hardhat test --parallel",
    "test:fork": "hardhat test --network hardhat",
    "compile": "hardhat compile",
    "clean": "hardhat clean",
    "node": "hardhat node",
    "deploy:local": "hardhat run scripts/deploy.ts --network localhost",
    "deploy:testnet": "hardhat run scripts/deploy.ts --network goerli",
    "verify": "hardhat verify",
    "size": "hardhat size-contracts",
    "lint": "eslint . --ext .ts",
    "lint:fix": "eslint . --ext .ts --fix",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^3.0.2",
    "@nomicfoundation/hardhat-network-helpers": "^1.0.8",
    "@nomiclabs/hardhat-ethers": "^2.2.3",
    "@nomiclabs/hardhat-waffle": "^2.0.6",
    "@typechain/ethers-v5": "^10.2.1",
    "@typechain/hardhat": "^6.1.6",
    "@types/chai": "^4.3.5",
    "@types/mocha": "^10.0.1",
    "@types/node": "^20.4.2",
    "@types/sinon": "^10.0.15",
    "chai": "^4.3.7",
    "ethereum-waffle": "^4.0.10",
    "ethers": "^5.7.2",
    "hardhat": "^2.17.0",
    "hardhat-gas-reporter": "^1.0.9",
    "mocha": "^10.2.0",
    "sinon": "^15.2.0",
    "solidity-coverage": "^0.8.2",
    "ts-node": "^10.9.1",
    "typechain": "^8.2.0",
    "typescript": "^5.1.6"
  },
  "dependencies": {
    "@openzeppelin/contracts": "^4.9.2",
    "@pinata/sdk": "^2.1.0",
    "web3.storage": "^4.5.4",
    "ipfs-http-client": "^60.0.1"
  },
  "keywords": [
    "blockchain",
    "ethereum",
    "defi",
    "dao",
    "nft",
    "ipfs",
    "testing",
    "hardhat"
  ],
  "author": "Urnlabs AI",
  "license": "MIT"
}