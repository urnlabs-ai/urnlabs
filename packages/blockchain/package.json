{
  "name": "@urnlabs/blockchain",
  "version": "1.0.0",
  "description": "Blockchain integration and Web3 features for Urnlabs AI Agent Platform",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest",
    "test:coverage": "vitest run --coverage",
    "compile": "hardhat compile",
    "deploy": "hardhat run scripts/deploy.ts",
    "deploy:testnet": "hardhat run scripts/deploy.ts --network sepolia",
    "deploy:mainnet": "hardhat run scripts/deploy.ts --network mainnet",
    "verify": "hardhat verify",
    "test:contracts": "hardhat test",
    "coverage:contracts": "hardhat coverage",
    "format": "prettier --write .",
    "lint": "eslint . --ext .ts",
    "clean": "rm -rf dist cache artifacts typechain-types"
  },
  "keywords": [
    "blockchain",
    "web3",
    "ethereum",
    "polygon",
    "smart-contracts",
    "nft",
    "defi",
    "ipfs",
    "agents"
  ],
  "dependencies": {
    "ethers": "^6.9.0",
    "web3": "^4.3.0",
    "@openzeppelin/contracts": "^5.0.1",
    "@openzeppelin/contracts-upgradeable": "^5.0.1",
    "ipfs-http-client": "^60.0.1",
    "@metamask/sdk": "^0.14.3",
    "@walletconnect/web3-provider": "^1.8.0",
    "@walletconnect/client": "^2.10.0",
    "pinata-sdk": "^2.1.0",
    "@chainlink/contracts": "^0.8.0",
    "@uniswap/v3-periphery": "^1.4.4",
    "@uniswap/v3-core": "^1.0.1",
    "axios": "^1.6.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.10.5",
    "@typescript-eslint/eslint-plugin": "^6.15.0",
    "@typescript-eslint/parser": "^6.15.0",
    "eslint": "^8.56.0",
    "prettier": "^3.1.1",
    "typescript": "^5.3.3",
    "vitest": "^1.1.0",
    "@vitest/coverage-v8": "^1.1.0",
    "hardhat": "^2.19.2",
    "@nomicfoundation/hardhat-toolbox": "^4.0.0",
    "@nomicfoundation/hardhat-verify": "^2.0.2",
    "@typechain/hardhat": "^9.1.0",
    "@typechain/ethers-v6": "^0.5.1",
    "typechain": "^8.3.2",
    "hardhat-gas-reporter": "^1.0.10",
    "solidity-coverage": "^0.8.5",
    "@nomicfoundation/hardhat-chai-matchers": "^2.0.2",
    "@nomicfoundation/hardhat-ethers": "^3.0.5",
    "chai": "^4.3.10"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}