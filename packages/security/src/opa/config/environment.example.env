# OPA Integration Environment Configuration
# Copy this file to .env and configure values for your environment

# =============================================================================
# OPA Server Configuration
# =============================================================================

# OPA Server URL (if using external OPA server)
OPA_SERVER_URL=http://localhost:8181

# OPA Server timeout in milliseconds
OPA_TIMEOUT=5000

# OPA retry attempts for failed requests
OPA_RETRY_ATTEMPTS=3

# Enable/disable OPA authorization middleware
OPA_AUTHORIZATION_ENABLED=true

# =============================================================================
# OPA Caching Configuration
# =============================================================================

# Enable decision caching
OPA_CACHE_ENABLED=true

# Cache TTL in milliseconds (5 minutes default)
OPA_CACHE_TTL=300000

# Maximum cache size (number of entries)
OPA_MAX_CACHE_SIZE=10000

# =============================================================================
# Policy Management Configuration
# =============================================================================

# Directory containing policy files
POLICY_DIRECTORY=./policies

# Directory for policy backups
POLICY_BACKUP_DIRECTORY=./policies/.backups

# =============================================================================
# Decision Logging Configuration
# =============================================================================

# Directory for decision logs
DECISION_LOG_DIRECTORY=./logs/decisions

# Maximum decision logs to keep in memory
MAX_DECISION_LOGS_IN_MEMORY=50000

# Encrypt decision logs on disk
ENCRYPT_DECISION_LOGS=true

# Enable compression for archived logs
COMPRESS_ARCHIVED_LOGS=true

# =============================================================================
# Audit Integration Configuration
# =============================================================================

# Audit service endpoint for decision logs
AUDIT_SERVICE_ENDPOINT=http://localhost:3000/audit

# API key for audit service
AUDIT_SERVICE_API_KEY=your-audit-api-key-here

# =============================================================================
# Security Tokens
# =============================================================================

# Token for decision logger service
DECISION_LOGGER_TOKEN=your-decision-logger-token-here

# Token for status logger service
STATUS_LOGGER_TOKEN=your-status-logger-token-here

# JWT signing key for internal services
JWT_SIGNING_KEY=your-jwt-signing-key-here

# =============================================================================
# Database Configuration (if using persistent storage)
# =============================================================================

# Database URL for policy and decision storage
DATABASE_URL=postgresql://username:password@localhost:5432/urnlabs_security

# Redis URL for caching
REDIS_URL=redis://localhost:6379

# =============================================================================
# Monitoring and Observability
# =============================================================================

# Enable Prometheus metrics
PROMETHEUS_METRICS_ENABLED=true

# Prometheus metrics port
PROMETHEUS_METRICS_PORT=9090

# Grafana admin password
GRAFANA_ADMIN_PASSWORD=admin

# =============================================================================
# Development/Testing Configuration
# =============================================================================

# Log level (debug, info, warn, error)
LOG_LEVEL=info

# Log format (json, text)
LOG_FORMAT=json

# Enable debug mode
DEBUG_MODE=false

# Enable policy validation on startup
VALIDATE_POLICIES_ON_STARTUP=true

# =============================================================================
# Performance Configuration
# =============================================================================

# Maximum policy evaluation time in milliseconds
MAX_POLICY_EVALUATION_TIME=1000

# Worker pool size for concurrent evaluations
WORKER_POOL_SIZE=10

# Request queue size
REQUEST_QUEUE_SIZE=1000

# =============================================================================
# Compliance Configuration
# =============================================================================

# Enable GDPR compliance features
GDPR_COMPLIANCE_ENABLED=true

# Enable SOX compliance features
SOX_COMPLIANCE_ENABLED=true

# Enable ISO27001 compliance features
ISO27001_COMPLIANCE_ENABLED=true

# Enable PCI compliance features
PCI_COMPLIANCE_ENABLED=true

# Data retention periods (in days)
GDPR_RETENTION_PERIOD=2555  # 7 years
SOX_RETENTION_PERIOD=2555   # 7 years
ISO27001_RETENTION_PERIOD=1095  # 3 years
PCI_RETENTION_PERIOD=365    # 1 year

# =============================================================================
# Geographic and Time-based Controls
# =============================================================================

# Allowed countries (comma-separated ISO country codes)
ALLOWED_COUNTRIES=US,CA,GB,DE,FR,AU,JP,SG

# Business hours start (hour in UTC)
BUSINESS_HOURS_START=9

# Business hours end (hour in UTC)
BUSINESS_HOURS_END=18

# =============================================================================
# Rate Limiting Configuration
# =============================================================================

# Default rate limit (requests per hour)
DEFAULT_RATE_LIMIT=1000

# Rate limit window in seconds
RATE_LIMIT_WINDOW=3600

# Enable distributed rate limiting with Redis
DISTRIBUTED_RATE_LIMITING=true

# =============================================================================
# Notification Configuration
# =============================================================================

# Slack webhook URL for security alerts
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/your/webhook/url

# Email service configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@domain.com
SMTP_PASS=your-email-password

# Security team email for alerts
SECURITY_TEAM_EMAIL=security@urnlabs.com

# =============================================================================
# Feature Flags
# =============================================================================

# Enable advanced analytics
ENABLE_ADVANCED_ANALYTICS=true

# Enable machine learning anomaly detection
ENABLE_ML_ANOMALY_DETECTION=false

# Enable real-time decision streaming
ENABLE_REAL_TIME_STREAMING=true

# Enable policy simulation mode
ENABLE_POLICY_SIMULATION=false

# =============================================================================
# Integration Configuration
# =============================================================================

# Kubernetes integration
KUBERNETES_ENABLED=false
KUBERNETES_NAMESPACE=urnlabs-security

# Envoy integration
ENVOY_EXTERNAL_AUTH_ENABLED=false
ENVOY_GRPC_PORT=9191

# API Gateway integration
API_GATEWAY_ENABLED=true
API_GATEWAY_ENDPOINT=http://localhost:7000

# =============================================================================
# Backup and Recovery
# =============================================================================

# S3 bucket for backups (if using cloud storage)
BACKUP_S3_BUCKET=urnlabs-opa-backups
BACKUP_S3_REGION=us-east-1
BACKUP_S3_ACCESS_KEY=your-access-key
BACKUP_S3_SECRET_KEY=your-secret-key

# Backup frequency (cron expression)
BACKUP_SCHEDULE=0 2 * * *  # Daily at 2 AM

# Backup retention period (days)
BACKUP_RETENTION_DAYS=90