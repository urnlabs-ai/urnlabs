{
  "name": "@urnlabs/security-compliance",
  "version": "1.0.0",
  "description": "Security & Compliance Service - Zero-Trust Security Framework",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "build": "tsc",
    "test": "jest",
    "lint": "eslint src/**/*.ts",
    "security-scan": "npm audit && snyk test",
    "ids:start": "tsx src/services/ids/ids-server.ts",
    "ids:train": "tsx src/services/ids/train-models.ts",
    "secrets:scan": "tsx src/cli/secrets-scanner.ts",
    "vault:init": "vault/scripts/init-vault.sh",
    "vault:migrate": "vault/scripts/migrate-secrets.sh",
    "vuln:process": "node src/cli/process-scan-results.js",
    "vuln:check": "node src/cli/check-thresholds.js",
    "vuln:remediate": "node src/cli/auto-remediate.js",
    "security:dashboard": "node src/cli/generate-dashboard.js"
  },
  "dependencies": {
    "fastify": "^4.24.3",
    "@fastify/cors": "^8.4.2",
    "@fastify/helmet": "^11.1.1",
    "@fastify/rate-limit": "^8.0.3",
    "bcrypt": "^5.1.1",
    "crypto": "^1.0.1",
    "pino": "^8.16.2",
    "pino-pretty": "^10.2.3",
    "@tensorflow/tfjs-node": "^4.15.0",
    "node-cron": "^3.0.3",
    "ws": "^8.14.2",
    "ioredis": "^5.3.2",
    "axios": "^1.6.2",
    "ml-matrix": "^6.10.7",
    "simple-statistics": "^7.8.3",
    "geoip-lite": "^1.4.8",
    "ua-parser-js": "^1.0.37",
    "winston": "^3.11.0",
    "cron": "^3.1.6",
    "events": "^3.3.0",
    "commander": "^11.1.0",
    "semver": "^7.5.4",
    "@open-policy-agent/opa-wasm": "^1.8.0",
    "node-fetch": "^3.3.2"
  },
  "devDependencies": {
    "tsx": "^4.6.2",
    "typescript": "^5.3.3",
    "@types/bcrypt": "^5.0.2",
    "@types/node": "^20.10.0",
    "@types/ws": "^8.5.10",
    "@types/ua-parser-js": "^0.7.39",
    "jest": "^29.7.0",
    "@types/jest": "^29.5.8",
    "ts-jest": "^29.1.1",
    "eslint": "^8.54.0",
    "@typescript-eslint/eslint-plugin": "^6.12.0",
    "@typescript-eslint/parser": "^6.12.0"
  },
  "keywords": [
    "security",
    "zero-trust",
    "authentication",
    "authorization",
    "encryption",
    "audit-logging",
    "compliance",
    "gdpr",
    "sox",
    "iso27001",
    "pci",
    "intrusion-detection",
    "behavioral-analysis",
    "anomaly-detection",
    "threat-intelligence",
    "machine-learning",
    "real-time-monitoring"
