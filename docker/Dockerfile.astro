# Multi-stage Dockerfile for Astro websites (urnlabs.ai & usmanramzan.ai)
# Supports both development and production builds

ARG NODE_VERSION=20
ARG SITE_NAME=urnlabs

# Development stage
FROM node:${NODE_VERSION}-alpine as dev
WORKDIR /app

# Install system dependencies
RUN apk add --no-cache libc6-compat curl

# Copy package files for the specific site
ARG SITE_NAME
COPY apps/${SITE_NAME}/package*.json ./apps/${SITE_NAME}/

# Install dependencies
WORKDIR /app/apps/${SITE_NAME}
RUN npm ci

# Copy source code
COPY apps/${SITE_NAME} .

# Expose port
EXPOSE 4321

# Health check
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD curl -f http://localhost:4321/ || exit 1

# Start development server
CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0", "--port", "4321"]

# Build stage
FROM node:${NODE_VERSION}-alpine as build
ARG SITE_NAME
WORKDIR /app

# Install system dependencies
RUN apk add --no-cache libc6-compat

# Copy package files and install dependencies
COPY apps/${SITE_NAME}/package*.json ./apps/${SITE_NAME}/
WORKDIR /app/apps/${SITE_NAME}
RUN npm ci

# Copy source and build
COPY apps/${SITE_NAME} .
RUN npm run build

# Production stage with Nginx
FROM nginx:alpine as production
ARG SITE_NAME

# Install security updates and curl for health checks
RUN apk update && apk upgrade && apk add --no-cache curl

# Copy built files from build stage
COPY --from=build /app/apps/${SITE_NAME}/dist /usr/share/nginx/html

# Create simple nginx config for static files
RUN echo 'events { worker_connections 1024; } \
http { \
  include /etc/nginx/mime.types; \
  default_type application/octet-stream; \
  sendfile on; \
  keepalive_timeout 65; \
  gzip on; \
  gzip_types text/plain text/css application/json application/javascript text/xml application/xml application/xml+rss text/javascript; \
  server { \
    listen 80; \
    server_name _; \
    root /usr/share/nginx/html; \
    index index.html; \
    add_header X-Frame-Options DENY; \
    add_header X-Content-Type-Options nosniff; \
    add_header X-XSS-Protection "1; mode=block"; \
    location / { \
      try_files $uri $uri/ /index.html; \
    } \
    location ~* \.(js|css|png|jpg|jpeg|gif|ico|svg)$ { \
      expires 1y; \
      add_header Cache-Control "public, immutable"; \
    } \
  } \
}' > /etc/nginx/nginx.conf

# Health check
HEALTHCHECK --interval=30s --timeout=3s --start-period=10s --retries=3 \
    CMD curl -f http://localhost/ || exit 1

# Expose port
EXPOSE 80

# Start Nginx
CMD ["nginx", "-g", "daemon off;"]